{"articles":{"0":{"body":{"0":"اگر غذائیت سے متعلق مشورے بہت زیادہ ہو گئے ہیں، تو سب سے آسان، سب سے مؤثر آلہ پلیٹ ہے۔ آپ کو کسی ایپ، پیمانے، یا غذائیت میں ڈگری کی ضرورت نہیں ہے۔ آپ کو ایسی شکل کی ضرورت ہے جو آپ کی آنکھ پہچان سکے۔","1":"اپنی پلیٹ کو کھردرے حصوں میں تقسیم کی تصویر بنائیں۔ نصف سبزیاں اور پھل، رنگ، فائبر، پانی، مائیکرو نیوٹرینٹس ہیں۔ ایک چوتھائی پروٹین، انڈے، مچھلی، چکن، پنیر، توفو، دال، پھلیاں۔ ایک چوتھائی پوری کاربوہائیڈریٹ، چاول، جئی، آلو، روٹی، پاستا، باجرا ہے۔ صحت مند چکنائی، زیتون کا تیل، گری دار میوے، بیج، ایوکاڈو کا انگوٹھے کے سائز کا حصہ شامل کریں۔","2":"یہ شکل بلڈ شوگر کو مستحکم کرتی ہے، پٹھوں کو سہارا دیتی ہے، آپ کو گھنٹوں بھرا رکھتی ہے، اور قدرتی طور پر آپ کو درکار زیادہ تر غذائی اجزاء فراہم کرتی ہے۔ آپ کو کسی چیز کا وزن یا گرام گننے کی ضرورت نہیں ہے۔","3":"اسے کسی بھی پکوان میں بنائیں۔ ہندوستانی: دال، چاول، سبزی، رائتہ، سلاد۔ بحیرہ روم: چکن، کوئنو، بھنی ہوئی سبزیاں، زیتون کا تیل۔ ایشیائی: ٹوفو، براؤن چاول، ہلچل تلی ہوئی سبزیاں۔ شکل ڈھل جاتی ہے؛ اصول رہتا ہے.","4":"ایک دن میں اس طرح کی تین پلیٹیں، اور اگر ضرورت ہو تو ایک یا دو ناشتہ، زیادہ تر لوگوں کی غذائی ضروریات کو آرام سے پورا کرتا ہے۔","5":"اگر کھانے میں پروٹین کا ٹکڑا نہیں ہے، تو آپ کو ایک یا دو گھنٹے کے اندر دوبارہ بھوک لگنے کا امکان ہے۔ اگر اس میں سبزیاں موجود نہیں ہیں، تو آپ میں فائبر اور مائیکرو نیوٹرینٹس کم ہوں گے جتنا آپ کو وقت گزرنے کے ساتھ احساس ہوگا۔","6":"آپ کو یہ کام مکمل طور پر کرنے کی ضرورت نہیں ہے۔ زیادہ تر دن، زیادہ تر کھانا، اس شکل میں۔ بہت ہو گیا۔"},"summary":"آدھی سبزیاں، ایک چوتھائی پروٹین، ایک چوتھائی سارا اناج۔ کسی ایپ کی ضرورت نہیں ہے۔","title":"پلیٹ، آسان"},"1":{"body":{"0":"خواتین کی غذائیت میں سب سے عام نمونوں میں سے ایک دن میں کم کھانا اور رات کو زیادہ کھانا ہے۔ یہ نظم و ضبط لگ رہا ہے؛ یہ دراصل ناکامی کا ایک سیٹ اپ ہے۔","1":"جب آپ ناشتہ چھوڑتے ہیں، دوپہر کا تھوڑا سا کھانا کھاتے ہیں، اور رات کے کھانے کے لیے کیلوریز کو 'بچاتے ہیں'، آپ کا بلڈ شوگر دوپہر کے وسط تک کم ہوجاتا ہے، شام تک آپ کی قوت ارادی کم ہوجاتی ہے، اور جسم عقلمندی سے آپ کو تیز کاربوہائیڈریٹ اور شوگر کی طرف لے جاتا ہے۔","2":"یہ کوئی اخلاقی ناکامی نہیں ہے۔ یہ حیاتیات ہے۔ جسم توانائی چاہتا ہے جب اسے توانائی کی ضرورت ہوتی ہے۔ دن کے وقت پابندی رات کو زیادہ کھانے کو قابل اعتماد طور پر متحرک کرتی ہے۔","3":"حل متضاد ہے: پہلے زیادہ کھائیں۔ پروٹین کے ساتھ ایک حقیقی ناشتہ۔ ایک تسلی بخش دوپہر کا کھانا۔ ایک متوازن رات کا کھانا۔ اگر آپ کو واقعی ان کی ضرورت ہو تو نمکین۔","4":"زیادہ تر خواتین پروٹین کو کم کھاتی ہیں اور اس بات کا اندازہ لگاتی ہیں کہ وہ کتنا کھا رہی ہیں۔ 25-35 گرام فی اہم کھانا ایک مفید ہدف ہے، یعنی ناشتے میں دو انڈے اور دہی، دوپہر اور رات کے کھانے میں ایک کھجور پنیر یا چکن۔","5":"کافی کھانا پٹھوں، ہارمونز، موڈ، نیند اور کھانے کے ساتھ پائیدار تعلق کی حفاظت کرتا ہے۔","6":"اگر آپ دائمی طور پر کم کھا رہے ہیں تو، آپ کی بھوک اور پیٹ بھرنے کے اشارے مل سکتے ہیں۔ وہ مستقل، اطمینان بخش کھانے کے ساتھ واپس آتے ہیں، عام طور پر چند ہفتوں کے اندر۔","7":"بھوک ایک اشارہ ہے دشمن کا نہیں۔ دن کے اوائل میں اسے سنیں ، اور دن کے بعد کی خواہشیں خود ہی سکڑ جاتی ہیں۔"},"summary":"پابندی الٹا فائر کرتی ہے۔ دن کے دوران کافی کھانا سب سے کم درجہ کا آلہ ہے۔","title":"بھوک دشمن نہیں ہے۔"},"2":{"body":{"0":"کئی دہائیوں سے، خواتین کو ہر چیز کے جواب کے طور پر کارڈیو فروخت کیا جاتا تھا۔ نتیجہ ایک ایسی نسل ہے جو زیادہ دوڑتی ہے، کم کھاتی ہے، اور ایسے جسم میں پھنسی رہتی ہے جو تبدیل نہیں ہوتی۔ لاپتہ ٹکڑا پٹھوں ہے.","1":"پٹھوں جسم میں سب سے زیادہ میٹابولک طور پر فعال ٹشو ہے۔ یہ آرام کے وقت کیلوریز کو جلاتا ہے، بلڈ شوگر کا استعمال کرتا ہے، ہارمونز کو سہارا دیتا ہے، آپ کی ہڈیوں کی حفاظت کرتا ہے، اور آپ کے جسم کی ساخت کو کسی بھی غذا سے زیادہ شکل دیتا ہے۔","2":"ہفتے میں دو مختصر طاقت کے سیشن، یہاں تک کہ 20-30 منٹ کے جسمانی وزن، ڈمبلز، یا مزاحمتی بینڈ کے ساتھ، معنی خیز طور پر مہینوں میں جسمانی ساخت کو تبدیل کرتے ہیں۔ پیمانہ آہستہ آہستہ چل سکتا ہے، لیکن آپ کا جسم کیسا لگتا ہے اور محسوس ہوتا ہے تیزی سے بدلتا ہے۔","3":"آپ کو جم کی ضرورت نہیں ہے۔ اسکواٹس، پھیپھڑے، پش اپس، بینڈ والی قطاریں، اور تختے جسم کے بیشتر حصے کو ڈھانپتے ہیں۔ 8-12 ریپس کے تین راؤنڈ، ہفتے میں دو بار، ایک طاقتور آغاز ہے۔","4":"طاقت کی تربیت 48 گھنٹے فی سیشن تک انسولین کی حساسیت کو بھی بہتر بناتی ہے، اضطراب کو کم کرتی ہے، نیند کو سہارا دیتی ہے، ہڈیوں کی کثافت کی حفاظت کرتی ہے، اور زندگی میں بعد میں گرنے کے خطرے کو کم کرتی ہے۔ صحت سائنس میں کچھ چیزیں آپ کے لیے مستقل طور پر اچھی ہیں۔","5":"دل کی صحت، مزاج اور برداشت کے لیے کارڈیو اب بھی اہمیت رکھتا ہے۔ لیکن یہ ایک تکمیلی چیز ہے، بنیاد نہیں۔ پیدل چلنا، ناچنا، تیراکی، پیدل سفر، روزانہ ہلکی پھلکی حرکت کے علاوہ ساختی طاقت جیتنے والا فارمولا ہے۔","6":"اگر آپ صفر سے شروع کر رہے ہیں تو بہت چھوٹی شروعات کریں۔ گھر میں جسمانی وزن کا سیشن۔ ایک YouTube ابتدائی۔ ایک مختصر کلاس۔ مستقل مزاجی ہر بار شدت کو شکست دیتی ہے۔"},"summary":"عضلات میٹابولزم کو چلاتے ہیں، ہفتے میں دو مختصر سیشن سب کچھ بدل دیتے ہیں۔","title":"طاقت نیا کارڈیو ہے۔"},"3":{"body":{"0":"غذائیت اور ہارمونز لازم و ملزوم ہیں۔ ہارمونز کولیسٹرول اور پروٹین سے بنتے ہیں، جو بلڈ شوگر کے ذریعے ریگولیٹ ہوتے ہیں، اور مٹھی بھر اہم مائیکرو نیوٹرینٹس کے ذریعے سپورٹ ہوتے ہیں۔ بنیادیں درست کریں اور بہت سے ہارمونل علامات میں آسانی ہو۔","1":"پروٹین بنیادی ہے۔ 25–35 گرام فی کھانا پٹھوں، موڈ، بالوں اور ہارمونز کے تعمیراتی بلاکس کو سپورٹ کرتا ہے۔ رات کا کھانا لوڈ کرنے کے بجائے اسے پورے دن میں پھیلائیں۔","2":"صحت مند چکنائی، زیتون کا تیل، گری دار میوے، بیج، ایوکاڈو، فیٹی مچھلی، ہارمون کی پیداوار کو براہ راست سپورٹ کرتے ہیں۔ بہت کم چکنائی والی غذا اکثر خاموشی سے سائیکل اور موڈ میں خلل ڈالتی ہے۔","3":"فائبر آپ کے جسم کو استعمال شدہ ایسٹروجن کو صاف کرنے میں مدد کرتا ہے۔ سبزیوں، پھلوں، پھلیاں، دال، اور سارا اناج سے روزانہ 25-30 گرام ہارمونز کو صحت مند نمونوں میں منتقل کرتا رہتا ہے۔","4":"مخصوص غذائی اجزاء اہمیت رکھتے ہیں۔ آئرن (اکثر حیض والی خواتین میں کم) توانائی کی حمایت کرتا ہے۔ میگنیشیم پی ایم ایس، نیند اور پٹھوں کو آرام دینے میں مدد کرتا ہے۔ زنک جلد اور بیضوی کی حمایت کرتا ہے۔ اومیگا 3s سوزش کو کم کرتا ہے۔ وٹامن ڈی موڈ، ہڈیوں اور مدافعتی فنکشن کی حمایت کرتا ہے۔","5":"مستحکم بلڈ شوگر سب سے طاقتور ہارمونل ٹولز میں سے ایک ہے۔ پروٹین اور چربی کے ساتھ کاربوہائیڈریٹ جوڑیں۔ خالی جگہ پر لمبے لمبے اسٹریچ جانے سے گریز کریں۔ کھانے کے بعد چہل قدمی کریں۔","6":"الکحل کو محدود کریں، یہ ایسٹروجن کو بڑھاتا ہے، نیند میں خلل ڈالتا ہے، اور بہت سے لوگوں کے لیے PMS کو خراب کرتا ہے۔","7":"اور کھانے کو خوشگوار رکھیں۔ مکمل طور پر کھانے کے بارے میں تناؤ ہارمونز میں اتنا ہی خلل ڈال سکتا ہے جتنا کہ اصل غذائیت کے فرق۔ ایک مستحکم نمونہ بنائیں، پھر اپنی زندگی سے لطف اندوز ہوں۔"},"summary":"مخصوص غذائی اجزاء سائیکل، توانائی اور موڈ کی حمایت کرتے ہیں۔","title":"ہارمونل صحت کے لیے کھانا"}},"myths":{"0":{"fact":"اضافی کیلوری کسی بھی ذریعہ سے ہوتی ہے۔ مکمل کاربوہائیڈریٹ آپ کے دماغ اور ورزش کو ایندھن دیتے ہیں۔","myth":"کاربوہائیڈریٹ آپ کا وزن بڑھاتے ہیں۔"},"1":{"fact":"کل روزانہ کی مقدار وقت سے زیادہ اہمیت رکھتی ہے۔","myth":"دیر سے کھانا وزن میں اضافے کا سبب بنتا ہے۔"},"2":{"fact":"آپ کے جگر اور گردے پہلے ہی خوبصورتی سے ایسا کرتے ہیں۔","myth":"ڈیٹوکس آپ کے جسم کو صاف کرتے ہیں۔"},"3":{"fact":"صحت مند چکنائی ہارمونز، دماغ اور ترپتی کی حمایت کرتی ہے۔ زیتون کے تیل، گری دار میوے، یا ایوکاڈو سے مت ڈریں.","myth":"چربی آپ کو موٹا بناتی ہے۔"},"4":{"fact":"یہ اکثر بیک فائر کرتا ہے، جس کی وجہ سے زیادہ کھانے اور میٹابولزم سست ہوجاتا ہے۔","myth":"کھانا چھوڑنا آپ کو وزن کم کرنے میں مدد کرتا ہے۔"},"5":{"fact":"معیار کی اہمیت ہے۔ بروکولی کی 200 کیلوریز اور 200 سوڈا آپ کے جسم کو بہت مختلف طریقے سے متاثر کرتے ہیں۔","myth":"تمام کیلوریز برابر ہیں۔"},"6":{"fact":"زیادہ تر غذائی اجزاء کھانے سے بہترین جذب ہوتے ہیں۔ صرف اس کی تکمیل کریں جس کی پیمائش کم ہے۔","myth":"آپ کو صحت مند رہنے کے لیے سپلیمنٹس کی ضرورت ہے۔"},"7":{"fact":"بھاری وزن اٹھانے سے ہڈی، عضلات اور اعتماد بڑھتا ہے۔ یہ آپ کو 'بڑی' نہیں بناتا ہے۔","myth":"خواتین کو بھاری وزن نہیں اٹھانا چاہئے۔"},"8":{"fact":"پروٹین سے بھرپور ناشتہ بعد میں زیادہ کھانے سے روک سکتا ہے۔ معیار تعدد سے زیادہ اہمیت رکھتا ہے۔","myth":"اسنیکنگ ہمیشہ وزن میں کمی کو سبوتاژ کرتی ہے۔"},"9":{"fact":"کھانا ایندھن اور لذت ہے، سزا یا جزا نہیں۔","myth":"آپ کو اپنا کھانا ورزش سے کمانا ہے۔"}},"stories":{"0":{"body":{"0":"میں نے اپنی بیسیوں کا زیادہ تر حصہ 'کم کھاؤ' کے کچھ ورژن پر گزارا۔ کیلوری گننے والی ایپس، کم چکنائی والی ہر چیز، سلاد لنچ۔ میں مسلسل بھوکا تھا اور مجھے یقین تھا کہ میں اس پر برا تھا۔","1":"ایک غذائیت پسند نے میرے کھانے کے لاگ کو دیکھا اور ایک بات کہی: 'آپ ایک دن میں تقریباً 40 گرام پروٹین کھا رہے ہیں۔ اسے دوگنا کرنے کی کوشش کریں۔'","2":"یہ متضاد محسوس ہوا۔ میں نے ناشتے میں انڈے، ناشتے کے طور پر یونانی دہی، دوپہر کے کھانے میں دال کا ایک اضافی حصہ، رات کے کھانے میں مچھلی یا پنیر شامل کیا۔","3":"دو ہفتوں کے اندر، میرے دوپہر کے کریش ختم ہو گئے۔ میرا ورزش مضبوط محسوس ہوا۔ مستقل خواہشات جن کا میں نے کسی قوت ارادی پر الزام نہیں لگایا تھا بس خاموش ہو گیا۔","4":"ان پہلے ہفتوں میں میرا وزن زیادہ نہیں بدلا۔ لیکن میرے جسم کی ساخت آہستہ آہستہ ہو گئی۔ اس سے بڑھ کر، کھانے کے ساتھ میرا رشتہ پابندی سے پرورش کی طرف منتقل ہو گیا۔","5":"اب میں پروٹین شمار کرتا ہوں، کیلوریز نہیں۔ یہ میں نے اب تک کی واحد سب سے مفید تبدیلی ہے۔"},"name":"ریا، 29","quote":"میں نے کیلوریز گننا بند کر دیا اور پروٹین گرام گننا شروع کر دیا۔ میری توانائی دوگنی ہو گئی۔"},"1":{"body":{"0":"میں روزانہ 'رات کے کھانے کے لیے کیا ہے' کے سوال میں ڈوب رہا تھا۔ دو بچے، کل وقتی کام، اور ایک ناممکن طور پر طویل ذہنی بوجھ۔ زیادہ تر ہفتے کی راتیں ٹیک آؤٹ اور جرم میں ختم ہوئیں۔","1":"میں نے کھانے کو تیار کرنے کی کوشش کی جس طرح انسٹاگرام نے دکھایا، پانچ ایک جیسے کنٹینرز، بالکل تقسیم۔ مجھے بدھ تک اس سے نفرت تھی۔","2":"پھر ایک دوست نے مشورہ دیا کہ 'ایک بار پکاؤ، دو بار کھاؤ۔' ہر دوسرے دن ایک بڑی چیز بنائیں، آدھی آج رات کھائیں، آدھی کل۔ اطراف کو مختلف کریں۔","3":"اس نے میرا ہفتہ بدل دیا۔ اتوار: روسٹ چکن + سبزی، آدھا اس رات کھایا، آدھا پیر کو لپیٹ میں کٹا ہوا۔ منگل: دال کا ایک بڑا برتن، اس رات چاول کے ساتھ کھایا گیا اور بدھ کے روز ناشتے میں ٹوسٹ کے اوپر۔","4":"میری شامیں کھل گئیں۔ ہم نے بہتر کھایا۔ میں نے ہفتے میں تین راتوں میں آرڈر دینا بند کر دیا۔","5":"میں تفصیل سے کھانا تیار نہیں کرتا۔ میں صرف دل کھول کر پکاتا ہوں۔ اس چھوٹی سی شفٹ نے میری عقل کو بچایا۔"},"name":"ڈی، 38","quote":"ایک بار کھانا پکانے اور دو بار کھانے سے میرا پورا ہفتہ آزاد ہو گیا۔"},"2":{"body":{"0":"میں نے 15 سے 30 سال کی عمر تک کسی نہ کسی شکل میں پرہیز کیا۔ اٹکنز، کم چکنائی، کم کارب، وقفے وقفے سے روزہ، جوس صاف کرتا ہے۔ ہر منصوبہ ایک binge اور میں نے شروع کیا سے زیادہ وزن میں ختم ہوا۔","1":"30 سال کی عمر میں، تھک کر، میں ایک رجسٹرڈ غذائی ماہر کے پاس گیا، منصوبہ بندی کے لیے نہیں، بلکہ منصوبہ بند کرنے میں مدد کے لیے۔ اس نے مجھ سے پوچھا کہ میں اصل میں کیا کھانا پسند کرتا ہوں۔ میں رو پڑی کیونکہ میں واقعی میں مزید نہیں جانتا تھا۔","2":"ہم نے بنیادی باتوں پر کام کیا: باقاعدگی سے کھانا، کافی پروٹین، سبزیاں جن سے میں نے لطف اٹھایا، میری ثقافت کے کھانے، کوئی ممنوعہ غذا۔ کوئی ٹریکنگ نہیں۔ کوئی اصول نہیں۔","3":"پہلا سال بے چین تھا۔ میرے وزن میں اتار چڑھاؤ آیا۔ میرا سر زور سے تھا۔ دھیرے دھیرے، میرے جسم نے اپنا سیٹنگ پوائنٹ پایا، اور یہ میرے پرہیز کے وزن سے زیادہ صحت مند وزن تھا جو کہ طویل مدتی نہیں تھا۔","4":"تین سال بعد، میں کھانے کے بارے میں اس طرح نہیں سوچتا جس طرح میں کرتا تھا۔ جب بھوک لگتی ہوں تو کھاتا ہوں۔ جب بھر جاتا ہوں تو رک جاتا ہوں۔ میں کھانے سے لطف اندوز ہوتا ہوں۔ آزادی ایک پیمانے پر کسی بھی تعداد سے زیادہ قیمتی ہے۔"},"name":"ثنا، 33","quote":"میں نے پرہیز کرنا چھوڑ دیا اور اپنی زندگی واپس حاصل کی۔"},"3":{"body":{"0":"میں نے 40 سال کا ہونے تک کبھی وزن نہیں اٹھایا تھا۔ میں نے دوڑ لگا دی تھی، یوگا کیا تھا، اسپن کلاسز میں گیا تھا، لیکن وزن اٹھانا ایسا محسوس ہوا کہ 'میرے لیے نہیں'۔","1":"ایک فزیو تھراپسٹ نے کمر کی چوٹ کے بعد مجھے بتایا کہ میں اپنے مستقبل کے لیے سب سے مضبوط چیز جو کر سکتا ہوں وہ پٹھوں کی تعمیر ہے۔ تو میں نے ہچکچاتے ہوئے شروع کیا۔","2":"ایک کوچ کے ساتھ ہفتے میں دو سیشن۔ 30 منٹ ہر ایک۔ شروع میں زیادہ تر جسمانی وزن۔","3":"تین ماہ کے اندر میری کمر کا درد ختم ہو گیا۔ چھ ماہ کے اندر، میں اس کے بارے میں سوچے بغیر اپنا گروسری تین پروازوں تک لے جا سکتا تھا۔","4":"میرا جسم اب مختلف نظر آتا ہے، چھوٹا نہیں بلکہ مضبوط۔ میری کرنسی بدل گئی۔ میری توانائی اٹھ گئی۔ میں بہتر سوتا ہوں۔","5":"میں 40 سال کی ہر عورت سے کہتا ہوں: ابھی زیادہ دیر نہیں ہوئی ہے۔ ہفتے میں دو مختصر سیشن۔ آپ کی زندگی کے اگلے 30 سالوں کو تبدیل کرنا شروع کرنے کے لیے بس اتنا ہی ہے۔"},"name":"میرا، 41","quote":"میری 40 کی دہائی میں طاقت کی تربیت نے مجھے ایک ایسا جسم دیا جس پر میں حقیقت میں بھروسہ کرتا ہوں۔"}},"subtitle":"بہتر صحت کے لیے موزوں غذائیت کے منصوبے اور وزن کے انتظام میں معاونت۔","tips":{"0":"ہر کھانے میں پروٹین کھائیں، کھجور کے سائز کا حصہ بنائیں۔","1":"ناشتے کے لیے پہنچنے سے پہلے پانی پی لیں۔","2":"ورزش کے دنوں میں ناشتہ نہ چھوڑیں۔","3":"سبزیوں کو اپنے فریج میں پکڑنے کے لیے سب سے آسان کھانا بنائیں۔","4":"7+ گھنٹے سوئیں، یہ بھوک کے ہارمونز کو کنٹرول کرتی ہے۔","5":"فی ہفتہ 30 مختلف پودوں کے کھانے کا ہدف بنائیں۔","6":"ایک بار پکائیں، دو بار کھائیں، بچا ہوا ہفتے کی راتیں بچائیں۔","7":"شراب کو محدود کریں، یہ نیند اور بھوک کے اشارے میں خلل ڈالتا ہے۔","8":"اپنے سب سے بڑے کھانے کے 10 منٹ بعد پیدل چلیں۔","9":"آنتوں کی صحت کے لیے خمیر شدہ غذائیں (دہی، کمچی، کیفر) شامل کریں۔","10":"اگر آپ شاذ و نادر ہی باہر ہوتے ہیں تو وٹامن ڈی کا اضافہ کریں۔","11":"اپنی کیلوریز نہ پیو، پورے پھلوں کا جوس۔"},"title":"غذائیت اور وزن","understanding":{"0":{"body":{"0":"خوراک معلومات ہے۔ ہر کھانا آپ کے ہارمونز، مدافعتی نظام، دماغ، آنتوں اور پٹھوں کو سگنل بھیجتا ہے۔ وہی جسم جو کھانے کے ایک سیٹ پر دھندلا ہوا محسوس کرتا ہے اور کسی چیز کو تبدیل کیے بغیر دوسرے پر صاف اور لچکدار محسوس کر سکتا ہے۔","1":"آپ جو کھاتے ہیں اس سے یہ شکل بنتی ہے کہ آپ گھنٹوں کے اندر کیسا محسوس کرتے ہیں (توانائی، مزاج، توجہ، خواہشات) اور آپ دہائیوں تک کیسے کام کرتے ہیں (دل، ہڈیاں، دماغ، ہارمونز، کینسر کا خطرہ)۔ دونوں ٹائم اسکیلز اہم ہیں، اور دونوں ایک ہی بنیادی اصولوں کا جواب دیتے ہیں۔","2":"خواتین کی زندگی کے تقریباً ہر مرحلے میں آئرن، کیلشیم، وٹامن ڈی، بی 12، فولیٹ، اومیگا تھری اور پروٹین کی زیادہ مانگ ہوتی ہے۔ ماہواری، حمل، دودھ پلانا، اور رجونورتی ہر ایک ریاضی کو بدل دیتا ہے، اور 'معیاری' غذائیت کے مشورے اکثر اس بات کو کم کرتے ہیں کہ آپ کو درحقیقت کیا ضرورت ہے۔","3":"ان کو خاموشی سے چھوڑنا تھکاوٹ، بالوں کا گرنا، موڈ میں خرابی، کمزور ورزش، بے قاعدہ سائیکل، ٹوٹے ہوئے ناخن، پریشانی اور بیماری سے خراب صحت یابی کے طور پر ظاہر ہوتا ہے۔ بہت سی خواتین برسوں سے کم درجے کی کمیوں کے ساتھ زندگی گزارتی ہیں، جب اصل مسئلہ ایندھن کا ہوتا ہے تو تناؤ کو مورد الزام ٹھہراتے ہیں۔","4":"غذائیت دونوں سمتوں میں تناؤ، نیند اور حرکت کے ساتھ تعامل کرتی ہے۔ کم نیند خواہشات کو بڑھاتی ہے۔ دائمی تناؤ بدلتا ہے کہ غذائی اجزاء کیسے جذب ہوتے ہیں۔ کم کھانے سے وہ توانائی ختم ہوجاتی ہے جس کی آپ کو ورزش کرنے کی ضرورت ہوتی ہے۔ آپ دوسروں کو مخاطب کیے بغیر ایک کو ٹھیک نہیں کر سکتے۔","5":"'منقطع' سے پہلے 'اضافہ' سوچیں۔ پروٹین، فائبر، رنگ، پانی، اور صحت مند چکنائی کو شامل کرنے سے قدرتی طور پر ان غذاؤں کو باہر نکال دیا جاتا ہے جو آپ کو نکال دیتے ہیں، بغیر کسی پابندی کے جو کہ پیدا کرتی ہے۔ زیادہ تر پائیدار غذائی تبدیلیاں اضافی ہوتی ہیں، سزا دینے والی نہیں۔","6":"ڈائیٹ کلچر نے حقیقی نقصان پہنچایا ہے۔ کئی دہائیوں کی پابندی، کیلوری کی گنتی، اور اخلاقی خوراک ('صاف،' 'دھوکہ،' 'اچھا،' 'خراب') نے بہت سی خواتین کو خود کھانے کے بارے میں بے چین کر دیا ہے۔ کھانے کے ساتھ اپنے تعلق کو ٹھیک کرنا غذائیت کا حصہ ہے، اس سے الگ نہیں۔","7":"غذائیت آپ کی زندگی کو سہارا دینے کے لیے ہے، اس پر قابو پانے کے لیے نہیں۔ اگر آپ کا کھانے کا منصوبہ آپ کو جنونی، الگ تھلگ، یا دکھی بنا رہا ہے، تو یہ کام نہیں کر رہا ہے، چاہے وہ کاغذ پر کتنا ہی 'صاف' کیوں نہ ہو۔"},"label":"غذائیت کیوں اہم ہے؟"},"1":{"body":{"0":"ایک متوازن پلیٹ تقریباً آدھی سبزیاں اور پھل، ایک چوتھائی پروٹین، ایک چوتھائی پوری کاربوہائیڈریٹ، نیز صحت مند چربی کا انگوٹھا ہے۔ یہ شکل زندگی کے تقریباً ہر مرحلے پر کام کرتی ہے اور زیادہ تر ثقافتی کھانوں اور بجٹ میں آسانی سے ڈھل جاتی ہے۔","1":"پروٹین خواتین کے لیے سب سے کم درجہ بندی کا ٹکڑا ہے، جس کا مقصد 25–35 گرام فی کھانا ہے، اگر آپ فعال ہیں یا پیرمینوپاز/مینوپاز میں ہیں تو مثالی طور پر 100–130 گرام فی دن۔ انڈے، مچھلی، چکن، یونانی دہی، کاٹیج پنیر، توفو، ٹیمپہ، دال، پھلیاں، اور پروٹین سے بھرپور اناج جیسے کوئنو سب شمار ہوتے ہیں۔","2":"کاربس دشمن نہیں ہیں۔ مکمل کاربوہائیڈریٹ (جئی، چاول، آلو، پھل، پھلیاں، پورے اناج کی روٹی اور پاستا) آپ کے دماغ، ورزش، ہارمونز اور تھائرائڈ کو ایندھن دیتے ہیں۔ دائمی کم کارب کھانا فعال خواتین میں سائیکل اور ٹینک توانائی کو دبا سکتا ہے۔","3":"صحت مند چکنائی ہارمونز، دماغ، بالوں، جلد اور وٹامن کے جذب کے لیے ضروری ہے۔ زیتون کا تیل، ایوکاڈو، گری دار میوے، بیج، چربی والی مچھلی (سالمن، سارڈینز، میکریل) اور دہی قابل اعتماد ذرائع ہیں۔ چربی سے پاک غذا ہارمونز پر خاموشی سے سخت ہوتی ہے۔","4":"فائبر ایک پرسکون ہیرو ہے، 25-35 گرام فی دن گٹ بیکٹیریا، بلڈ شوگر، کولیسٹرول، ہارمون کلیئرنس، اور ترپتی کی حمایت کرتا ہے۔ زیادہ تر بالغوں کو یہ رقم نصف سے بھی کم ملتی ہے۔","5":"ہائیڈریشن کی اہمیت ہے، زیادہ تر بالغوں کو روزانہ 2-3 لیٹر کی ضرورت ہوتی ہے، گرمی میں یا ورزش کے ساتھ۔ ہلکی پانی کی کمی تھکاوٹ، سر درد اور دماغی دھند کی طرح نظر آتی ہے۔","6":"شکل اتنی ہی مختلف ہوتی ہے۔ ہر ہفتے 30 مختلف پودوں کی خوراک (سبزیاں، پھل، جڑی بوٹیاں، مصالحے، گری دار میوے، بیج، پھلیاں، سارا اناج تمام شمار) کا ہدف رکھیں۔ گٹ تنوع پودوں کے تنوع کی پیروی کرتا ہے۔","7":"کھانے کا وقت زیادہ تر انفرادی ہوتا ہے، معلوم کریں کہ آپ کے لیے کیا کام کرتا ہے۔ تین کھانے کے علاوہ ایک ناشتہ زیادہ تر کے لیے کام کرتا ہے۔ کچھ چار چھوٹے کھانے کو ترجیح دیتے ہیں۔ کچھ طویل فاسٹنگ ونڈوز کے ساتھ اچھا کرتے ہیں۔ 'صحیح' تال وہ ہے جو آپ کو متحرک اور مستحکم رکھتا ہے۔","8":"تھوڑا سا منصوبہ بنائیں، زیادہ نہیں۔ پروٹین، آسان کاربوہائیڈریٹس، منجمد سبزیوں، پھلوں اور پینٹری کے اسٹیپلز کے ساتھ باورچی خانے میں ذخیرہ کرنا مستثنیٰ کی بجائے متوازن کھانا بناتا ہے۔"},"label":"متوازن غذا"},"2":{"body":{"0":"ایک صحت مند وزن وہ ہے جو آپ کا جسم اس وقت طے کرتا ہے جب نیند، خوراک، حرکت اور تناؤ مستحکم ہو۔ یہ چارٹ پر شاذ و نادر ہی ایک نمبر ہوتا ہے، یہ وہ رینج ہے جس کا آپ کا جسم دفاع کرتا ہے، اور اس حد کی تشکیل کیلوریز سے کہیں زیادہ ہوتی ہے۔","1":"جسمانی وزن جینیات، ہارمونز، عمر، طبی حالات (PCOS، تھائرائڈ، انسولین مزاحمت)، ادویات (اینٹی ڈپریسنٹ، ہارمونل مانع حمل، سٹیرائڈز)، نیند کا معیار، تناؤ کا بوجھ، اور زندگی کے مرحلے سے تشکیل پاتا ہے۔ وزن کو قوت ارادی کا مسئلہ سمجھنا زیادہ تر اصل متغیرات کو نظر انداز کر دیتا ہے۔","2":"وزن ایک سگنل ہے، سگنل نہیں. توانائی، طاقت، نیند کا معیار، موڈ، لیبڈو، لیب مارکر (HbA1c، لپڈز، بلڈ پریشر)، اور کپڑے کیسے فٹ ہوتے ہیں یہ صرف پیمانے سے کہیں زیادہ مکمل کہانی سناتا ہے۔ بہت سے لوگ پیمانے پر زیادہ حرکت کیے بغیر صحت مند ہوجاتے ہیں۔","3":"سست اور معاون وزن میں تبدیلی تقریباً ہر بار جیت جاتی ہے۔ جارحانہ پابندی میٹابولک موافقت، پٹھوں کی کمی، ہارمون میں خلل، اور ریباؤنڈ کو متحرک کرتی ہے، جو عام طور پر لوگوں کو چند سالوں میں شروع ہونے والے سے زیادہ بھاری چھوڑ دیتی ہے۔ پائیدار تبدیلی جان بوجھ کر بورنگ ہے۔","4":"پروٹین اور طاقت کی تربیت دو سب سے کم درجہ بندی والے اوزار ہیں۔ پروٹین وزن میں کمی کے دوران پٹھوں کو محفوظ رکھتا ہے۔ طاقت کی تربیت میٹابولزم کو لچکدار رکھتی ہے۔ وہ ایک ساتھ مل کر جسمانی ساخت کو تبدیل کرتے ہیں یہاں تک کہ جب پیمانہ آہستہ چلتا ہے۔","5":"نیند وزن کو زیادہ تر غذا سے زیادہ کنٹرول کرتی ہے۔ نیند کی کمی بھوک کے ہارمونز کو بڑھاتی ہے، معموریت کے اشارے کو کم کرتی ہے، اور چینی اور بہتر کاربوہائیڈریٹ کی خواہش کو بڑھاتی ہے۔ ایک ہفتے کی خراب نیند ایک مہینے کے محتاط کھانے کو ختم کر سکتی ہے۔","6":"تناؤ بھی اہمیت رکھتا ہے۔ دائمی کورٹیسول تبدیلیاں کرتا ہے جہاں جسم چربی ذخیرہ کرتا ہے (اکثر وسط کے ارد گرد)، جذباتی کھانے کو چلاتا ہے، اور نیند میں خلل ڈالتا ہے، ایک مکمل لوپ جس کا قوت ارادی سے کوئی تعلق نہیں ہے۔","7":"ہارمونل زندگی کے مراحل وزن کو نئی شکل دیتے ہیں۔ پیریمینوپاز، زچگی کے بعد، اور گولی کے بعد کی منتقلی سبھی عارضی طور پر وزن کے ضابطے کو تبدیل کرتی ہیں۔ اسٹیج کو سمجھنا اپنے آپ پر الزام لگانے سے زیادہ مفید ہے۔","8":"ایک رجسٹرڈ غذائی ماہر یا ڈاکٹر کے ساتھ کام کرنا (ایک فلاح و بہبود پر اثر انداز کرنے والے کے بجائے) اکثر ترقی اور ایک اور ناکام کوشش کے درمیان فرق ہوتا ہے، خاص طور پر اگر PCOS، تھائیرائیڈ کے مسائل، یا کھانے کی خراب تاریخ تصویر کا حصہ ہو۔","9":"وزن قدر، نظم و ضبط، یا قدر کا پیمانہ نہیں ہے۔ بڑے جسم والے لوگ ناکام پتلے لوگ نہیں ہوتے۔ پتلے جسم والے لوگ خود بخود صحت مند نہیں ہوتے۔ صحت اور وزن اوورلیپ، لیکن وہ ایک ہی چیز نہیں ہیں۔"},"label":"صحت مند وزن"},"3":{"body":{"0":"غذائیت ہارمونز، گٹ، دماغ، جلد، قوت مدافعت، نیند، موڈ، زرخیزی، اور میٹابولزم کو تشکیل دیتی ہے۔ جسم کا تقریباً کوئی ایسا نظام نہیں ہے جسے کھانا نہ چھوتا ہو، یہی وجہ ہے کہ صحیح ایڈجسٹمنٹ اکثر ایک ساتھ کئی چیزوں کو بہتر بناتی ہے۔","1":"ہارمونل صحت کا انحصار مستقل غذائیت پر ہے۔ چھوڑ دیا گیا کھانا، بہت کم کیلوریز والے دن، اور جسم میں دائمی کم کھانے کے سگنل کی کمی، جو تھائیرائیڈ، سست میٹابولزم، اور پرسکون سائیکل کو دبا سکتی ہے۔ ہارمونز کو ایندھن کی ضرورت ہوتی ہے۔","2":"گٹ اور غذائیت لازم و ملزوم ہیں۔ فی ہفتہ 30 مختلف پودے، کافی مقدار میں فائبر، خمیر شدہ کھانے (دہی، کیفیر، سیورکراٹ، کمچی) اور کم سے کم الٹرا پروسیسڈ فوڈز کا مقصد بنائیں۔ ایک صحت مند آنت موڈ، قوت مدافعت، ہارمون کلیئرنس اور سوزش کو متاثر کرتی ہے۔","3":"دماغی صحت اور غذائیت کا گہرا تعلق ہے۔ اومیگا 3s، بی وٹامنز، آئرن، وٹامن ڈی، میگنیشیم، اور مستحکم بلڈ شوگر سبھی پریشانی اور افسردگی کو متاثر کرتے ہیں۔ غذائیت تھراپی یا ادویات کا متبادل نہیں ہے، لیکن یہ دونوں کے لیے ایک طاقتور پارٹنر ہے۔","4":"جلد، بال اور ناخن غذائیت کی حیثیت کے سست تاثرات کے اشارے ہیں۔ جب پروٹین، آئرن، زنک اور صحت مند چکنائی بحال ہو جاتی ہے تو ٹوٹے ہوئے ناخن، بالوں کا گرنا، خستہ جلد، اور آہستہ سے شفا بخش بریک آؤٹ اکثر ڈرامائی طور پر بہتر ہو جاتے ہیں۔","5":"غذائیت ادویات اور نقل و حرکت کا ایک طاقتور ساتھی ہے۔ جب مستقل کھانے کے ساتھ جوڑا بنایا جائے تو بہت سی دوائیں بہتر کام کرتی ہیں۔ بہت سے ورزش مناسب ایندھن کے ساتھ زیادہ ادائیگی کرتے ہیں۔ تربیت سے باہر کرنے کی کوشش کرنا یا دواؤں سے باہر ناقص غذائیت شاذ و نادر ہی کام کرتی ہے۔","6":"زندگی کے تمام مراحل میں تبدیلی کی ضرورت ہے۔ حمل اور دودھ پلانے سے مطالبات میں تیزی سے اضافہ ہوتا ہے۔ perimenopause پروٹین اور کیلشیم کی ضروریات کو اوپر کی طرف منتقل کرتا ہے۔ پوسٹ مینوپاز ہڈیوں اور پٹھوں کی مدد پر زور دیتا ہے۔ پلیٹ باب کے ساتھ تیار ہوتی ہے۔","7":"غلو سے پرہیز کریں۔ طبی وجہ کے بغیر تمام فوڈ گروپس کو کاٹنا اکثر الٹا فائر کرتا ہے۔ اس طرح کھاتا ہے جو بھی، جب بھی، بغیر کسی ساخت کے۔ درمیانی، متنوع، باقاعدہ، زیادہ تر پوری خوراک، جس میں لذت کی گنجائش ہے، وہ جگہ ہے جہاں زیادہ تر لوگ ترقی کرتے ہیں۔","8":"ہفتے میں چند بار کھانا پکانا بھی غذائیت کی اعلیٰ ترین عادات میں سے ایک ہے۔ آپ کو ایک بہترین باورچی بننے کی ضرورت نہیں ہے۔ آپ کو کھانے کی ایک چھوٹی سی گردش کی ضرورت ہے جو آپ آٹو پائلٹ پر بنا سکتے ہیں۔","9":"چھوٹی شروعات کریں۔ ایک مستقل عادت بدل گئی (ایک پروٹین فارورڈ ناشتہ، دوپہر کے کھانے میں پھل کا ایک ٹکڑا، کافی سے پہلے ایک گلاس پانی) وقت کے ساتھ ساتھ ایک مختلف جسم بن جاتا ہے۔ مرکب سود غذائیت کے لیے بھی کام کرتا ہے۔"},"label":"غذائیت کا کردار"}}}
{"food":{"items":{"0":{"detail":"دال، پالک، کدو کے بیج، اور دبلا گوشت آپ کے سائیکل کے ذریعے توانائی بحال کرتے ہیں۔","subtitle":"PMS تھکاوٹ اور کمزوری کو کم کرنے میں مدد کرتا ہے۔","title":"آئرن اور زنک سے بھرپور غذائیں کھائیں۔"},"1":{"detail":"ڈیری، مضبوط پودوں کا دودھ، اور پتوں والی سبزیاں آپ کی ہڈیوں کو طویل مدتی تحفظ فراہم کرتی ہیں۔","subtitle":"ہڈیوں کی حمایت کرتا ہے اور PMS علامات کو کم کرتا ہے۔","title":"کیلشیم کی مقدار میں اضافہ کریں۔"},"2":{"detail":"پروسس شدہ شوگر سوزش کو بڑھاتی ہے، درد اور کم موڈ کا ایک پرسکون ڈرائیور۔","subtitle":"سوزش اور موڈ کے جھولوں کو کم کرتا ہے۔","title":"چینی اور تلی ہوئی اشیاء سے پرہیز کریں۔"},"3":{"detail":"کم سوڈیم = پانی کی کم برقراری، خاص طور پر آپ کی ماہواری سے پہلے کے دنوں میں۔","subtitle":"اپھارہ کو روکنے میں مدد کرتا ہے۔","title":"نمک پر کاٹ دیں۔"},"4":{"detail":"دونوں نیند میں خلل ڈال سکتے ہیں اور PMS کو خراب کر سکتے ہیں۔ ہربل چائے کے لیے ایک کپ تبدیل کرنے کی کوشش کریں۔","subtitle":"ہارمونز کو متوازن رکھتا ہے۔","title":"کیفین اور الکحل کو محدود کریں۔"},"5":{"detail":"سالمن، اخروٹ اور فلیکسیڈ سوزش اور مستحکم مزاج کو پرسکون کرنے میں مدد کرتے ہیں۔","subtitle":"ہارمونز کو سپورٹ کرتا ہے اور درد کو کم کرتا ہے۔","title":"اومیگا 3 فیٹی ایسڈ شامل کریں۔"},"6":{"detail":"ہر 3-4 گھنٹے بعد کھانے سے بلڈ شوگر اور توانائی مستحکم رہتی ہے۔","subtitle":"متلی اور تیزابیت کو کم کرتا ہے۔","title":"چھوٹا، بار بار کھانا کھائیں۔"},"7":{"detail":"انڈے، مچھلی، پھلیاں اور یونانی دہی پٹھوں، ہارمونز اور ترپتی کی مدد کرتے ہیں۔","subtitle":"ترقی اور بحالی کی حمایت کرتا ہے","title":"اعلیٰ معیار کے پروٹین کا انتخاب کریں۔"},"8":{"detail":"ایوکاڈو، زیتون کا تیل، اور گری دار میوے ضروری ہیں، چربی آپ کے ہارمونز کے لیے ایندھن ہے۔","subtitle":"ہارمونز اور چمکدار جلد کو سپورٹ کرتا ہے۔","title":"صحت مند چربی میں اضافہ کریں۔"}},"subtitle":"اپنی مجموعی تندرستی کو سہارا دینے کے لیے سمارٹ نیوٹریشن ٹپس سیکھیں۔","title":"کھانا"},"hair-skin":{"items":{"0":{"detail":"اپنے کلینزر کو اپنی جلد کی قسم، تیل والی جلد کے لیے نرم جیل، خشک جلد کے لیے کریمی فارمولوں سے ملائیں۔","sub
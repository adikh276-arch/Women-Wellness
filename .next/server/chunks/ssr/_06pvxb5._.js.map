{"food":{"items":{"0":{"detail":"Kacang lentil, bayam, biji labu, dan daging tanpa lemak mengembalikan energi sepanjang siklus menstruasi Anda.","subtitle":"Membantu mengurangi kelelahan dan kelemahan akibat PMS.","title":"Konsumsi Makanan yang Kaya Zat Besi dan Seng"},"1":{"detail":"Produk susu, susu nabati yang diperkaya, dan sayuran hijau memberikan perlindungan jangka panjang bagi tulang Anda.","subtitle":"Mendukung kesehatan tulang & mengurangi gejala PMS","title":"Tingkatkan Asupan Kalsium"},"2":{"detail":"Gula olahan memicu peradangan, yang merupakan penyebab tersembunyi kram dan suasana hati yang buruk.","subtitle":"Mengurangi peradangan & perubahan suasana hati","title":"Hindari Gula & Makanan Gorengan"},"3":{"detail":"Kadar natrium yang lebih rendah = retensi air yang lebih sedikit, terutama pada hari-hari sebelum menstruasi.","subtitle":"Membantu mencegah kembung","title":"Kurangi Konsumsi Garam"},"4":{"detail":"Keduanya dapat mengganggu tidur dan memperburuk PMS. Cobalah mengganti satu cangkir dengan teh herbal.","subtitle":"Menjaga keseimbangan hormon","title":"Batasi Kafein & Alkohol"},"5":{"detail":"Salmon, kenari, dan biji rami membantu meredakan peradangan dan menstabilkan suasana hati.","subtitle":"Mendukung hormon & mengurangi kram","title":"Tambahkan Asam Lemak Omega-3"},"6":{"detail":"Makan setiap 3-4 jam menjaga kadar gula darah dan energi tetap stabil.","subtitle":"Mengurangi mual & asam lambung","title":"Makanlah dalam porsi kecil dan lebih sering."},"7":{"detail":"Telur, ikan, kacang-kacangan, dan yogurt Yunani bermanfaat untuk otot, hormon, dan rasa kenyang.","subtitle":"Mendukung pertumbuhan & pemulihan","title":"Pilih Protein Berkualitas Tinggi"},"8":{"detail":"Alpukat, minyak zaitun, dan kacang-kacangan sangat penting, lemak adalah bahan bakar untuk hormon Anda.","subtitle":"Mendukung keseimbangan hormon & kulit berc bercahaya","title":"Tingkatkan Asupan Lemak Sehat"}},"subtitle":"Pelajari kiat nutrisi cerdas untuk mendukung kesehatan Anda secara keseluruhan.","title":"Makanan"},"hair-skin":{"items":{"0":{"detail":"Pilihlah pembersih wajah yang sesuai dengan jenis kulit Anda, gel lembut untuk kulit berminyak, dan formula krim untuk kulit kering.","subtitle":"Pilihlah pembersih yang tepat untuk kulit Anda.","title":"Pilih Sabun Cuci Muka Anda dengan Cerdas"},"1":{"detail":"Membersihkan wajah di malam hari menghilangkan polutan seharian sehingga kulit Anda dapat memperbaiki diri saat Anda tidur.","subtitle":"Bersihkan kotoran dan riasan sebelum tidur.","title":"Gunakan Pembersih Wajah di Malam Hari"},"2":{"detail":"Menggunakan SPF 30+ setiap pagi adalah kebiasaan anti-penuaan terbaik yang dapat Anda bangun.","subtitle":"Perlindungan matahari setiap hari sangat penting.","title":"Tetap Gunakan Tabir Surya"},"3":{"detail":"Vitamin C di pagi hari membantu menetralkan radikal bebas dari sinar matahari dan polusi.","subtitle":"Lindungi kulit dari kerusakan.","title":"Pilihlah Antioksidan"},"4":{"detail":"Krim retinoid atau peptida yang digunakan pada malam hari mendukung produksi kolagen dan pergantian sel.","subtitle":"Perbaiki kulit saat Anda tidur.","title":"Rutinitas Perawatan Malam"},"5":{"detail":"Gunakan eksfolian kimia 1-2 kali seminggu, hindari scrub kasar yang menyebabkan luka mikro.","subtitle":"Lakukan eksfoliasi dengan lembut, jangan kasar.","title":"Pengelupasan Kulit Itu Penting"},"6":{"detail":"Kondisioner menutup kutikula, mengunci kelembapan dan mengurangi kerusakan.","subtitle":"Penting digunakan setelah setiap kali mencuci.","title":"Kondisikan Rambut Anda"},"7":{"detail":"Memangkas rambut setiap 8-12 minggu sekali akan menjaga ujung rambut tetap sehat dan pertumbuhan rambut terlihat lebih lebat.","subtitle":"Mencegah ujung rambut bercabang","title":"Potong Rambut Anda Secara Teratur"},"8":{"detail":"Kortisol memicu timbulnya jerawat dan pengelupasan kulit. Tidur, bernapas, dan istirahat semuanya penting.","subtitle":"Stres berdampak pada kulit & rambut","title":"Bersantai dan Hilangkan Stres"}},"subtitle":"Temukan tips sederhana untuk rambut sehat dan kulit berc bercahaya.","title":"Rambut & Kulit"},"pms":{"items":{"0":{"detail":"Makanan utuh dengan kandungan protein dan karbohidrat kompleks yang stabil dapat meringankan gejala selama siklus menstruasi.","subtitle":"Mendukung keseimbangan hormon & mengurangi kelelahan","title":"Ikuti Pola Makan Seimbang dan Kaya Nutrisi"},"1":{"detail":"Bahkan berjalan kaki selama 20 menit dapat melepaskan endorfin yang secara diam-diam melawan perasaan lesu akibat PMS.","subtitle":"Meningkatkan suasana hati & meredakan kram","title":"Berolahragalah Secara Teratur"},"2":{"detail":"Stres memperburuk setiap gejala PMS. Latihan pernapasan dan istirahat adalah hal yang mutlak.","subtitle":"Mengurangi gejala emosional","title":"Mengelola Stres Secara Efektif"},"3":{"detail":"Meskipun terdengar tidak logis, namun benar adanya: lebih banyak air berarti lebih sedikit retensi air.","subtitle":"Mengurangi kembung & rasa tidak nyaman","title":"Jaga tubuh tetap terhidrasi dengan baik."},"4":{"detail":"Usahakan tidur selama 7-9 jam, terutama pada fase luteal ketika tidur sering terganggu.","subtitle":"Meningkatkan suasana hati & energi","title":"Tidurlah yang Cukup"},"5":{"detail":"Keduanya memperburuk kecemasan, nyeri payudara, dan gangguan tidur sebelum menstruasi.","subtitle":"Mencegah masalah tidur & suasana hati","title":"Batasi Kafein & Alkohol"},"6":{"detail":"Magnesium, vitamin B6, dan vitamin D memiliki bukti yang kuat, bicarakan dulu dengan dokter Anda.","subtitle":"Membantu meredakan kram & kelelahan","title":"Konsumsi Suplemen Penting"},"7":{"detail":"Kompres hangat di perut bagian bawah dapat menyaingi obat pereda nyeri kram yang dijual bebas.","subtitle":"Meredakan kram secara alami","title":"Gunakan Terapi Panas untuk Meredakan Nyeri"},"8":{"detail":"Buah beri, ikan berlemak, kunyit, dan sayuran hijau dapat meredakan peradangan penyebab kram.","subtitle":"Membantu mengurangi nyeri PMS","title":"Sertakan Makanan Anti-Inflamasi"}},"subtitle":"Temukan cara efektif untuk mengelola gejala PMS dan merasa lebih baik setiap bulannya.","title":"PMS"},"weight-loss":{"items":{"0":{"detail":"Gantilah roti putih dan kue-kue dengan biji-bijian utuh untuk menjaga kadar gula darah tetap stabil.","subtitle":"Mencegah lonjakan gula darah & penambahan lemak","title":"Kurangi Konsumsi Karbohidrat Olahan"},"1":{"detail":"Porsi seukuran telapak tangan di setiap makan mengurangi keinginan makan dan melindungi otot.","subtitle":"Membuat Anda kenyang & meningkatkan metabolisme","title":"Konsumsi Lebih Banyak Protein"},"2":{"detail":"Seringkali, rasa haus disamarkan sebagai rasa lapar, mulailah setiap makan dengan segelas air.","subtitle":"Mendukung pembakaran lemak & mengurangi rasa lapar","title":"Minumlah Lebih Banyak Air"},"3":{"detail":"Dua sesi latihan kekuatan per minggu mengubah komposisi tubuh lebih banyak daripada latihan kardio tanpa henti.","subtitle":"Membangun otot & membakar lebih banyak kalori","title":"Tambahkan Latihan Ketahanan"},"4":{"detail":"Untuk kesehatan jantung, kombinasikan jalan santai dengan jalan cepat intensitas tinggi dalam waktu singkat.","subtitle":"Membakar kalori & meningkatkan kebugaran","title":"Lakukan Lebih Banyak Latihan Kardio"},"5":{"detail":"Usahakan mengonsumsi 25–30g setiap hari dari sayuran, kacang-kacangan, buah-buahan, dan biji-bijian utuh.","subtitle":"Membuat Anda kenyang lebih lama","title":"Konsumsi Serat yang Cukup"},"6":{"detail":"Makanan utuh mengandung nutrisi; makanan olahan sebagian besar mengandung tambahan yang tidak Anda butuhkan.","subtitle":"Mengurangi kalori kosong","title":"Batasi Makanan Olahan & Gula"},"7":{"detail":"Tenangkan diri, hindari layar, otak Anda membutuhkan waktu sekitar 20 menit untuk menyadari rasa kenyang.","subtitle":"Mencegah makan berlebihan","title":"Praktikkan Makan dengan Penuh Kesadaran"},"8":{"detail":"Kurang dari 7 jam tidur meningkatkan ghrelin dan menurunkan kemauan. Tidur adalah alat untuk menurunkan berat badan.","subtitle":"Menyeimbangkan hormon rasa lapar","title":"Tidur yang Cukup"}},"subtitle":"Dapatkan tips praktis untuk pengelolaan berat badan yang sehat dan berkelanjutan.","title":"Penurunan Berat Badan"}}
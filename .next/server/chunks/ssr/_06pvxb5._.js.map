{"articles":{"0":{"body":{"0":"اینڈومیٹرائیوسس ایک ایسی حالت ہے جس میں بچہ دانی کے استر کی طرح ٹشو بچہ دانی کے باہر، بیضہ دانی، فیلوپین ٹیوبوں، آنتوں، مثانے اور شرونی میں کہیں اور بڑھتے ہیں۔ یہ ماہواری والے 10 میں سے 1 لوگوں کو متاثر کرتا ہے۔","1":"یہ کتنا عام ہے اس کے باوجود، اوسط تشخیص میں 7-10 سال لگتے ہیں۔ درد کو اکثر 'خراب ادوار' کے طور پر مسترد کر دیا جاتا ہے، اور واحد حتمی تشخیص لیپروسکوپک سرجری ہے، حالانکہ امیجنگ اور ایک محتاط طبی تصویر اس کی سختی سے تجویز کر سکتی ہے۔","2":"علامات میں شدید دورانیے میں درد (اکثر بغیر جوابی درد کی دوا کے لیے غیر جوابدہ)، سائیکل کے دوسرے اوقات میں درد، جنسی تعلقات کے ساتھ درد، دردناک آنتوں کی حرکت یا ماہواری کے دوران پیشاب، بھاری خون بہنا، تھکاوٹ، اور بانجھ پن شامل ہیں۔ ہر کسی کے پاس یہ سب کچھ نہیں ہوتا۔","3":"درد متناسب نہیں ہے کہ کتنا اینڈومیٹرائیوسس موجود ہے۔ ہلکی بیماری والے کسی کو شدید درد ہو سکتا ہے۔ وسیع بیماری کے ساتھ کسی کو بہت کم ہو سکتا ہے.","4":"علاج تہہ دار ہے۔ درد کا انتظام (گرمی، NSAIDs، بعض اوقات نسخے کی دوائیں)، ہارمونل تھراپی (گولی، صرف پروجیسٹرون کے اختیارات، ہارمونل IUDs، GnRH agonists)، شرونیی منزل کی فزیوتھراپی، طرز زندگی میں تبدیلیاں، اور سرجری (لیپروسکوپی سے ایکسائز گھاووں) سبھی کردار ادا کرتے ہیں۔","5":"صرف طرز زندگی ہی اینڈومیٹرائیوسس کا 'علاج' نہیں کرے گا، لیکن سوزش سے بچنے والا کھانا، تناؤ کا انتظام، ہلکی حرکت، نیند، اور شرونیی فرش کا کام طبی علاج کے ساتھ ساتھ علامات کو معنی خیز طور پر کم کر سکتا ہے۔","6":"اگر آپ کو اینڈومیٹرائیوسس کا شبہ ہے تو، مخصوص تجربہ رکھنے والے معالج کو تلاش کریں، ایک عام ماہر امراض چشم کافی نہیں ہو سکتا۔ Endometriosis کے ماہرین موجود ہیں اور ڈرامائی طور پر ریلیف کا راستہ مختصر کر دیتے ہیں۔","7":"سب سے اہم بات: شدید مدت کا درد آپ کی غلطی نہیں ہے، آپ کے سر میں نہیں ہے، اور ایسی کوئی چیز نہیں ہے جس سے گزرنا ہو۔ جوابات ہیں اور حقیقی دیکھ بھال ہے۔"},"summary":"بچہ دانی کے استر سے ملتے جلتے ٹشو بچہ دانی کے باہر اگتے ہیں، اکثر درد کا باعث بنتے ہیں۔","title":"Endometriosis کی بنیادی باتیں"},"1":{"body":{"0":"تھائرائڈ آپ کی گردن کے سامنے تتلی کی شکل کا ایک چھوٹا سا غدود ہے، لیکن اس کا اثر بہت زیادہ ہے۔ تائرایڈ ہارمونز میٹابولزم، توانائی، جسمانی درجہ حرارت، موڈ، دل کی دھڑکن، عمل انہضام، اور یہاں تک کہ سائیکل کی باقاعدگی کو منظم کرتے ہیں۔","1":"مردوں کے مقابلے خواتین میں تائرواڈ کی خرابی بہت زیادہ عام ہے، خاص طور پر 30 سے 60 سال کی عمر کے درمیان۔ ہائپوتھائیرائڈزم (انڈر ایکٹیو) سب سے زیادہ عام ہے، لیکن ہائپر تھائیرائیڈزم (زیادہ فعال) اور ہاشیموٹو اور گریوز جیسی خود کار قوت مدافعت بھی اکثر ہوتی ہیں۔","2":"ہائپوتھائیرائیڈزم کی علامات میں تھکاوٹ، وزن میں اضافہ، سردی کی عدم برداشت، خشک جلد، بالوں کا پتلا ہونا، قبض، کم مزاج، دماغی دھند، بھاری یا زیادہ وقت، اور دل کی دھڑکن کا سست ہونا شامل ہیں۔ یہ اکثر ڈپریشن کے طور پر غلط تشخیص کیا جاتا ہے.","3":"Hyperthyroidism اس کے برعکس نظر آتا ہے، بے چینی، دوڑتا ہوا دل، وزن میں کمی، گرمی کی عدم برداشت، تھرتھراہٹ، ہلکے ادوار، اور نیند میں دشواری۔ یہ گھبراہٹ کی خرابی کی شکایت کے طور پر غلط تشخیص کیا جا سکتا ہے.","4":"تشخیص سیدھا ہے لیکن اکثر نامکمل ہے۔ زیادہ تر بنیادی ٹیسٹ صرف TSH چیک کرتے ہیں۔ ایک مکمل تصویر میں مفت T4، مفت T3، اور تھائیرائڈ اینٹی باڈیز (TPO، TgAb) شامل ہیں۔ اگر 'نارمل' TSH کے باوجود علامات برقرار رہیں تو مکمل پینل کے لیے پوچھیں۔","5":"علاج انتہائی موثر ہے۔ Hypothyroidism کا علاج عام طور پر روزانہ لیوتھیروکسین کے ساتھ کیا جاتا ہے، بعض اوقات T3 کے ساتھ مل کر۔ Hyperthyroidism کے لیے اینٹی تھائیرائیڈ ادویات، تابکار آئوڈین، یا شاذ و نادر ہی سرجری کی ضرورت پڑ سکتی ہے۔","6":"طرز زندگی بھی اہم ہے۔ مناسب آئوڈین (آئوڈائزڈ نمک یا مچھلی سے)، سیلینیم (برازیل گری دار میوے، مچھلی)، زنک، آئرن، اور وٹامن ڈی سبھی تھائرائڈ کے کام کو سپورٹ کرتے ہیں۔ دائمی تناؤ اور شدید کم خوراک تائیرائڈ ہارمونز کو دبا سکتی ہے۔","7":"اگر آپ سب کچھ آزمانے کے باوجود موڈ، توانائی یا وزن کے ساتھ جدوجہد کر رہے ہیں، تو تھائیڈرو کے مکمل کام کے لیے پوچھیں۔ جواب اکثر حیرت انگیز طور پر آسان ہوتا ہے۔"},"summary":"کم یا زیادہ فعال تھائیرائیڈ ڈپریشن، اضطراب اور تھکاوٹ کی نقل کر سکتا ہے۔","title":"تائرواڈ اور آپ کا مزاج"},"2":{"body":{"0":"پیشاب کی نالی کا انفیکشن خواتین کے ڈاکٹر سے ملنے کی سب سے عام وجوہات میں سے ایک ہے۔ زیادہ تر اس وقت ہوتا ہے جب بیکٹیریا، عام طور پر آنتوں سے، مختصر خواتین کی پیشاب کی نالی کو مثانے میں لے جاتے ہیں۔","1":"علامات میں پیشاب کرتے وقت جلنا، عجلت، تعدد، پیٹ کا کم دباؤ، اور بعض اوقات ابر آلود یا تیز بو والا پیشاب شامل ہیں۔ پیشاب میں خون، بخار، کمر میں درد، یا سردی لگنے کا مطلب یہ ہو سکتا ہے کہ انفیکشن گردوں تک پہنچ گیا ہے اور اسے فوری دیکھ بھال کی ضرورت ہے۔","2":"روک تھام زیادہ تر سادہ عادات کے بارے میں ہے۔ کافی پانی پئیں (دن میں تقریباً 2 لیٹر) تاکہ آپ باقاعدگی سے پیشاب کریں۔ پیشاب کی نالی سے بیکٹیریا نکالنے کے لیے جنسی تعلقات کے بعد پیشاب کریں۔ آگے سے پیچھے مسح کریں۔ پیشاب کو زیادہ دیر تک روکنے سے گریز کریں۔","3":"جب ممکن ہو سانس لینے کے قابل سوتی انڈرویئر پہنیں۔ جینٹل ایریا میں خوشبو والے صابن، ڈوچز اور وائپس سے پرہیز کریں، یہ قدرتی مائکروبیل توازن میں خلل ڈالتے ہیں جو آپ کی حفاظت کرتا ہے۔","4":"اگر آپ کو سال میں 2-3 بار سے زیادہ UTIs ہوتے ہیں، تو اینٹی بائیوٹکس کے دوسرے دور کے بجائے ورزش کرنے کو کہیں۔ اسباب میں مثانے کا نامکمل خالی ہونا، کم ایسٹروجن (خاص طور پر پیری مینوپاز اور پوسٹ مینوپاز میں)، گردے کی پتھری، یا جسمانی عوامل شامل ہو سکتے ہیں۔","5":"پوسٹ مینوپاسل بار بار آنے والے UTIs کے لیے، کم خوراک والا اندام نہانی ایسٹروجن اکثر زندگی بدل دیتا ہے اور بہت سے لوگوں کے لیے بھی محفوظ ہے جو نظاماتی ہارمون تھراپی کا استعمال نہیں کر سکتے۔","6":"کرین بیری کی مصنوعات اور D-mannose کے پاس معمولی ثبوت ہیں اور یہ کوشش کرنے کے لیے مناسب ہیں، لیکن وہ حفظان صحت کی اچھی عادات یا طبی دیکھ بھال کی جگہ نہیں لیتے ہیں جب ضرورت ہو۔","7":"انفیکشن کا فوری علاج کریں، غیر پیچیدہ UTIs کو عام طور پر اینٹی بائیوٹکس کے مختصر کورس سے حل کیا جاتا ہے۔ اس کا انتظار نہ کریں، اور بچ جانے والی اینٹی بائیوٹکس کا اشتراک نہ کریں۔"},"summary":"ہائیڈریشن، سیکس کے بعد پیشاب کرنا، اور سامنے سے پیچھے کا مسح زیادہ تر UTIs کو روکتا ہے۔","title":"UTIs: گھبراہٹ سے بچاؤ"},"3":{"body":{"0":"خود کار قوت مدافعت کے حالات، جہاں مدافعتی نظام غلطی سے جسم کے اپنے ٹشوز پر حملہ کرتا ہے، خواتین کو مردوں کے مقابلے میں تین گنا زیادہ متاثر کرتی ہے۔ Hashimoto's, Graves', lupus, rheumatoid arthritis, MS, type 1 diabetes, celiac, and psoriasis سب سے زیادہ عام ہیں۔","1":"علامات بڑے پیمانے پر مختلف ہوتی ہیں اس بات پر منحصر ہے کہ کس ٹشو کو نشانہ بنایا جا رہا ہے، لیکن بہت سے خود بخود حالات دھاگوں کا اشتراک کرتے ہیں: تھکاوٹ، جوڑوں یا پٹھوں میں درد، دماغی دھند، جلد کی تبدیلی، آنتوں کے مسائل، اور غیر متوقع بھڑک اٹھنا۔","2":"تشخیص اکثر سست ہوتا ہے۔ علامات مبہم ہو سکتی ہیں، خون کے ٹیسٹ میں اتار چڑھاؤ آ سکتا ہے، اور ایک خود بخود حالت دوسری کو چھپا سکتی ہے۔ بہت سی خواتین واضح تصویر حاصل کرنے سے پہلے متعدد ماہرین کو دیکھتی ہیں۔","3":"ایک بار تشخیص ہونے کے بعد، کام پرتوں پر مشتمل ہوتا ہے: ادویات (اکثر مدافعتی ماڈیولنگ)، نگرانی، اور ایک طرز زندگی جو مدافعتی نظام کو دبانے کے بجائے مدد کرتا ہے۔","4":"نیند بنیادی ہے۔ نیند کا دائمی نقصان خود بخود قوت مدافعت کو خراب کرتا ہے۔ ایک مستقل شیڈول کے مطابق 7-9 گھنٹے کا مقصد بنائیں، اور اسے اپنے طبی منصوبے کے حصے کے طور پر سمجھیں، اختیاری نہیں۔","5":"تناؤ اسی طرح طاقتور ہے۔ دائمی تناؤ بہت سے لوگوں کے لیے بھڑک اٹھتا ہے۔ تھراپی، روزمرہ کی نرم مشقیں، باہر کا وقت، اور حد سے زیادہ کمٹمنٹ کو نہ کہنا سب معنی خیز مدد کرتے ہیں۔","6":"کھانے کے پیٹرن حالت کے لحاظ سے مختلف ہوتے ہیں، لیکن زیادہ تر خود کار قوت دوست غذا اصولوں کا اشتراک کرتے ہیں: کافی پروٹین، کافی مقدار میں سبزیاں، فائبر، اومیگا 3s، کم الٹرا پروسیسڈ فوڈز، اور مخصوص محرکات پر انفرادی توجہ (جیسے سیلیک میں گلوٹین)۔","7":"ایک چھوٹی، ماہر ٹیم بنائیں۔ خود اس حالت کا ماہر، ایک بنیادی ڈاکٹر جو ہم آہنگی کرتا ہے، اور مثالی طور پر دماغی صحت فراہم کرنے والا، خود سے قوت مدافعت کی زندگی بھاری ہے، اور آپ کو اسے اکیلے اٹھانے کی ضرورت نہیں ہے۔ بہت سے لوگ خود کار قوت مدافعت کے حالات کے ساتھ مکمل، وشد زندگی گزارتے ہیں؛ وہ صرف دیکھ بھال کے ساتھ رہتے ہیں."},"summary":"خواتین کیوں زیادہ متاثر ہوتی ہیں، اور ان کے ارد گرد ایک پائیدار زندگی کیسے بنائی جائے۔","title":"آٹومیمون حالات کے ساتھ رہنا"}},"myths":{"0":{"fact":"عام لیبز کا مطلب ہمیشہ عام زندگی نہیں ہوتا۔ اپنے جسم پر بھروسہ کریں اور دوسری رائے تلاش کریں۔","myth":"اگر ٹیسٹ نارمل ہیں تو کچھ بھی غلط نہیں ہے۔"},"1":{"fact":"درد حقیقی اور قابل پیمائش ہے۔ یہ ایک شخصیت کی خاصیت نہیں ہے۔","myth":"خواتین کو صرف درد زیادہ محسوس ہوتا ہے۔"},"2":{"fact":"زیادہ تر صحیح منصوبہ بندی اور مدد کے ساتھ انتہائی قابل انتظام ہیں۔","myth":"دائمی حالات کا مطلب ہے ہار ماننا۔"},"3":{"fact":"بہت سی حالتیں نصابی کتابوں کی تجویز سے پہلے ظاہر ہوتی ہیں، علامات عمر سے زیادہ اہمیت رکھتی ہیں۔","myth":"آپ اس شرط کے لیے بہت چھوٹے ہیں۔"},"4":{"fact":"یہ خواتین کے لیے بھی موت کی سب سے بڑی وجہ ہے، اور علامات اکثر مختلف نظر آتی ہیں۔","myth":"دل کی بیماری انسان کا مسئلہ ہے۔"},"5":{"fact":"وہ 12 میں سے 1 خواتین کو متاثر کرتے ہیں، جو اکثر ان کی 20-40 کی دہائی میں مارتے ہیں۔","myth":"آٹومیمون بیماریاں نایاب ہیں۔"},"6":{"fact":"اپنے آنتوں پر بھروسہ کریں۔ دوسری رائے نے بے شمار جانیں بچائی ہیں۔","myth":"اگر کوئی ڈاکٹر آپ کو برخاست کرتا ہے، تو آپ ڈرامائی ہو رہے ہیں۔"},"7":{"fact":"یہ پورے مہینے میں آنتوں، مثانے، جنس، زرخیزی اور توانائی کو متاثر کر سکتا ہے۔","myth":"Endometriosis صرف ماہواری میں درد کا سبب بنتا ہے۔"},"8":{"fact":"بار بار ہونے والے انفیکشن کے لیے اکثر گہرے ورزش کی ضرورت ہوتی ہے، نہ صرف زیادہ اینٹی بائیوٹکس۔","myth":"اینٹی بایوٹک ہمیشہ بار بار آنے والی UTIs کو ٹھیک کر دے گی۔"},"9":{"fact":"یہ خواتین میں ہائپوٹائیرائڈزم کی سب سے عام وجوہات میں سے ایک ہے۔","myth":"ہاشموٹو نایاب ہے۔"}},"stories":{"0":{"body":{"0":"13 سال کی عمر میں اپنی پہلی ماہواری سے، میں وہ لڑکی تھی جس نے منصوبے منسوخ کیے، اسکول چھوٹ دیا، اور باتھ روم کے فرش پر جھک گئی۔ ہر ڈاکٹر کو میں نے دیکھا ایک ہی بات کہی: 'کچھ خواتین کو صرف حیض خراب ہوتا ہے۔'","1":"22 تک، میں تین مختلف گولیوں پر تھا امید ہے کہ ایک کام کرے گا. 27 تک، میں اپنے سائیکل کے ارد گرد اپنے کیریئر کا انتظام کر رہا تھا. میں مسلسل تھکا ہوا تھا اور خاموشی سے استعفیٰ دے رہا تھا۔","2":"31 سال کی عمر میں، ایک نئے جی پی نے، جو اس کی 40 کی دہائی میں ہے، میری طرف دیکھا اور کہا: 'میرے خیال میں یہ اینڈومیٹرائیوسس ہے۔ آئیے معلوم کرتے ہیں۔' چھ ماہ بعد لیپروسکوپی کے بعد اس کی تصدیق ہوئی۔","3":"اس کا نام رکھنا اس کی اپنی راحت کی شکل تھی۔ بتائے جانے کے سالوں سے یہ میرے سر میں ایک ہی تشخیص میں تحلیل ہو گیا تھا۔","4":"علاج جاری ہے، ایک ہارمونل IUD، شرونیی منزل کا فزیو، سوزش سے بچنے والا کھانا، اور ماہر کے ساتھ باقاعدگی سے چیک ان۔ میرے پاس ابھی بھی مشکل ہفتے ہیں۔ لیکن میں اب خود کو جلا نہیں رہا ہوں۔","5":"اگر آپ کو سالوں سے بتایا گیا ہے کہ 'یہ صرف برا ادوار ہے'، تو براہ کرم دوسری رائے حاصل کریں۔ آپ یقین کرنے کے لائق ہیں۔"},"name":"سارہ، 35","quote":"اینڈو کی تشخیص میں 9 سال لگے۔ نام دینے سے سب کچھ بدل گیا۔"},"1":{"body":{"0":"میں جب تک یاد کر سکتا تھا تھکا ہوا تھا۔ اپنی بیسویں دہائی کے آخر تک، میں نے کام پر الزام لگایا۔ اپنی تیس کی دہائی میں، میں نے زچگی کو مورد الزام ٹھہرایا۔ 40 تک، میں جملے کے وسط کے الفاظ کو یاد رکھنے کے لیے جدوجہد کر رہا تھا۔","1":"میری معیاری لیبز ہمیشہ 'نارمل' تھیں۔ میرا TSH رینج کے اونچے سرے پر تھا، لیکن تکنیکی طور پر ٹھیک تھا۔","2":"آخر میں، ایک دوست جو ڈاکٹر ہے نے مجھے مفت T3، مفت T4، اور اینٹی باڈیز مانگنے کو کہا۔ ہاشموٹو کی اینٹی باڈیز زیادہ واپس آگئیں۔","3":"علاج نے راتوں رات سب کچھ ٹھیک نہیں کیا، لیکن تین مہینوں کے اندر اندر دھند اتنی بڑھ گئی کہ میں نے دوبارہ اپنے جیسا محسوس کیا۔ میری توانائی انکریمنٹ میں واپس آگئی۔","4":"میں نے سیکھا کہ لیب کی رپورٹ پر 'نارمل' کا مطلب ہمیشہ 'آپ کے لیے نارمل' نہیں ہوتا۔ مکمل تصویر مانگنے سے میری زندگی بدل گئی۔","5":"اگر آپ برسوں سے جدوجہد کر رہے ہیں اور آپ کو کچھ بھی غلط نہیں بتایا جا رہا ہے، تو مکمل تھائرائڈ پینل کے لیے دھکیلیں۔ یہ ٹیسٹوں کا ایک سادہ سیٹ ہے جو بہت کچھ بتاتا ہے۔"},"name":"ہانا، 42","quote":"ایک تھائرائڈ پینل نے آخر کار اس دھند کی وضاحت کی جس کو میں نے برسوں سے اٹھایا تھا۔"},"2":{"body":{"0":"میرے پاس تقریباً ایک دہائی تک ایک سال میں کم از کم چار UTIs تھے۔ اینٹی بائیوٹک نے کام کیا، پھر وہ واپس آگئے۔ مجھے زیادہ پانی پینے، جنسی تعلقات کے بعد پیشاب کرنے، کرینبیری لینے کو کہا گیا۔ میں نے یہ سب کیا۔","1":"میرے 30 کی دہائی کے آخر میں پیری مینوپاز شروع ہونے کے بعد، UTIs مزید خراب ہو گئے۔ ایک urogynecologist نے آخر کار کم خوراک اندام نہانی ایسٹروجن تجویز کیا۔","2":"میں شکی تھا، اور تھوڑا سا خوفزدہ تھا کہ میں آن لائن ہارمونز کے بارے میں کیا پڑھوں گا۔ اس نے مجھے کم خوراک والے اندام نہانی ایسٹروجن اور سیسٹیمیٹک ایچ آر ٹی کے درمیان فرق کے بارے میں بتایا، اور یہ بہت سے لوگوں کے لیے بھی کتنا محفوظ ہے جو نظامی قسم کا استعمال نہیں کر سکتے۔","3":"تین ماہ کے اندر UTIs بند ہو گئے۔ میرے پاس اب ایک سال سے زیادہ نہیں ہوا ہے۔","4":"میں ہر اس عورت سے کہتا ہوں جسے میں جانتا ہوں: اگر بار بار آنے والے UTIs آپ کی زندگی کا حصہ ہیں، خاص طور پر پیری مینوپاز کے آس پاس، تو اندام نہانی ایسٹروجن کے بارے میں پوچھیں۔ یہ خاموشی سے زندگی بدلنے والا ہے۔"},"name":"ریما، 38","quote":"جب تک اندام نہانی ایسٹروجن ان کو ختم نہیں کر دیتا تب تک بار بار آنے والے UTIs میرے معمول کے مطابق تھے۔"},"3":{"body":{"0":"مجھے 33 سال کی عمر میں لیوپس کی تشخیص ہوئی۔","1":"جس چیز نے سب سے زیادہ مدد کی وہ واحد علاج نہیں تھا۔ یہ میری اپنی انتباہی علامات کو پڑھنا سیکھ رہا تھا، بھڑک اٹھنے سے پہلے ٹھیک ٹھیک تھکاوٹ، بری نیند کے ہفتوں پر مشترکہ سختی، جس طرح سے تناؤ میرے جسم میں دنوں تک بیٹھا رہا۔","2":"میں نے ایک چھوٹی ٹول کٹ بنائی۔ نیند میری سب سے اہم دوا ہے۔ میں تھکنے سے پہلے آرام کرتا ہوں، بعد میں نہیں۔ میں روزانہ آہستہ آہستہ چلتا ہوں۔ میں کھانے کو سادہ اور مستحکم رکھتا ہوں۔","3":"میں نے بھی بہت کچھ نہیں کہا۔ وہ دوستیاں جو مجھے بہا گئیں۔ کام کے وعدے جو بہت زیادہ تھے۔ خود کا وہ ورژن جس نے ہر چیز کو ہاں کہا تھا ختم ہو گیا ہے، اور میں اس کے لیے بہتر ہوں۔","4":"لوپس اب بھی میری زندگی کا حصہ ہے۔ لیکن اس سے میری زندگی اب نہیں چلتی۔ اس تبدیلی میں برسوں اور بہت زیادہ خود اعتمادی لگے۔"},"name":"انیا، 45","quote":"لیوپس کے ساتھ رہنے نے مجھے اپنے جسم کو سننے کا طریقہ سکھایا۔"}},"subtitle":"خواتین کی صحت کی مختلف حالتوں کے لیے ماہر کی دیکھ بھال اور انتظام۔","tips":{"0":"کسی بھی ماہر سے ملنے سے پہلے علامتی جریدہ رکھیں۔","1":"ملاقات کے لیے کسی دوست یا ساتھی کو لے کر آئیں، دو کان بہتر ہیں۔","2":"پوچھو: 'یہ اور کیا ہو سکتا ہے؟' اگر آپ کو برخاست محسوس ہوتا ہے۔","3":"ایک جگہ پر ادویات اور مضر اثرات کو ٹریک کریں۔","4":"سالانہ لیبز حاصل کریں: تھائرائڈ، آئرن، وٹامن ڈی، بی 12، گلوکوز۔","5":"مکمل تھائرائیڈ پینل کی درخواست کریں، نہ صرف TSH۔","6":"UTI کے خطرے کو کم کرنے کے لیے جنسی تعلقات کے بعد پیشاب کریں۔","7":"سوتی انڈرویئر پہنیں؛ خوشبو والے دھونے کو چھوڑ دیں۔","8":"اگر کوئی ڈاکٹر آپ کو مسترد کرتا ہے، تو دوسری رائے طلب کریں۔","9":"روزانہ حرکت کریں، یہاں تک کہ 10 منٹ بھی سوزش کو کم کرتے ہیں۔","10":"نیند دائمی حالات کی دوا ہے، 7-9 گھنٹے کی حفاظت کریں۔","11":"اینٹی بائیوٹکس کا اشتراک نہ کریں یا مکمل کورس کو نہ چھوڑیں۔"},"title":"طبی حالات","understanding":{"0":{"body":{"0":"خواتین کے جسموں کو طبی حالات کے انوکھے مرکب کا سامنا کرنا پڑتا ہے، جن میں سے اکثر کسی بھی عمر میں ظاہر ہو سکتے ہیں، اینڈومیٹرائیوسس، فائبرائڈز، ایڈینومائوسس، پی سی او ایس، تھائیرائیڈ ڈس آرڈرز (ہاشیموٹو، گریوز، ذیلی کلینیکل ہائپوٹائرائڈزم)، خود کار قوت مدافعت کی بیماریاں (لیوپس، رمیٹی سندشوت، ایک سے زیادہ سکلیرویمیا، مائیگرا، فلورائڈز، مائیکروسافٹ)۔ عوارض، اور دائمی درد کے حالات جیسے fibromyalgia.","1":"یہ حالات اکثر اوورلیپ ہوتے ہیں اور اکثر یاد رہتے ہیں۔ علامات کا الزام تناؤ، اضطراب، یا 'صرف تھکاوٹ' پر لگایا جاتا ہے جب کوئی قابل شناخت، قابل علاج حالت موجود ہو۔ بہت سی خواتین سالوں تک سنتی ہیں کہ 'آپ کی لیبز نارمل ہیں' اس سے پہلے کہ کوئی صحیح ٹیسٹ کرے یا صحیح سوال کرے۔","2":"ابتدائی شناخت بہت زیادہ تکلیف کو کم کرتی ہے۔ جتنی لمبی حالت بے نام رہتی ہے، اتنی ہی زیادہ یہ روزمرہ کی زندگی، نیند، کام، تعلقات، ذہنی صحت کو شکل دیتی ہے۔ Endometriosis کی تشخیص میں اب بھی اوسطاً 7-10 سال لگتے ہیں۔ ہاشموٹو کو اکثر ایک دہائی تک یاد کیا جاتا ہے۔ ناموں اور نمونوں کو جاننا آدھی جنگ ہے۔","3":"ایک اچھا علامتی جریدہ مبہم تجربے کو ایسی چیز میں بدل دیتا ہے جس پر ایک معالج عمل کر سکتا ہے۔ تاریخ، علامات، شدت (1-10)، آپ کیا کر رہے تھے، آپ نے کیا کھایا، آپ اپنے سائیکل میں کہاں تھے، نیند کا معیار، اور تناؤ کی سطح کو ٹریک کریں۔ اس کے تین ماہ میں تقرریوں کو مکمل طور پر تبدیل کر دیا جاتا ہے۔","4":"آپ سے خود کی تشخیص کی توقع نہیں ہے۔ آپ سے توقع کی جاتی ہے کہ آپ اپنے جسم کے ماہر ہوں گے، آپ کے لیے کیا معمول ہے، کیا نیا ہے، کیا بدل رہا ہے۔ معالجین آپ کو پندرہ منٹ کے لیے دیکھتے ہیں۔ آپ اپنے جسم میں 24/7 رہتے ہیں۔","5":"دوسری رائے حاصل کرنے سے نہ گھبرائیں۔ پہلا ڈاکٹر ہمیشہ صحیح ڈاکٹر نہیں ہوتا ہے، اور 'نارمل' نتائج کے ساتھ مستقل علامات کے لیے اکثر آنکھوں کے تازہ سیٹ کی ضرورت ہوتی ہے، اکثر ایک ماہر کے بجائے ایک ماہر۔","6":"ان میں سے بہت سے حالات امتزاج کے نقطہ نظر کا اچھا جواب دیتے ہیں: ٹارگٹڈ میڈیکل ٹریٹمنٹ کے علاوہ وہی بنیادیں جو ہر چیز میں مدد کرتی ہیں (نیند، کھانا، حرکت، تناؤ، کمیونٹی)۔ نہ ہی اکیلے عام طور پر کافی ہے.","7":"ایک دائمی حالت کا مطلب یہ نہیں ہے کہ پوری زندگی کو ترک کر دیا جائے۔ اس کا مطلب ہے ایک ایسی زندگی بنانا جو آپ کے جسم کے ساتھ کام کرتی ہے نہ کہ اس کے خلاف، جو اکثر اس سے بہتر زندگی بنتی ہے جس پر آپ پہلے مجبور کر رہے تھے۔"},"label":"صحت کے مختلف حالات"},"1":{"body":{"0":"زیادہ تر طبی تاریخ کے لیے مردانہ جسموں پر تحقیق کی گئی۔ 1990 کی دہائی تک خواتین کو اکثر کلینیکل ٹرائلز سے خارج کر دیا جاتا تھا، اور آج بھی بہت سی دوائیوں کی خوراک، علامات کی جانچ پڑتال، اور 'نارمل' رینجز کو مرد فزیالوجی پر کیلیبریٹ کیا جاتا ہے۔ خلا بند ہو رہا ہے، لیکن یہ اب بھی حقیقی ہے۔","1":"یہ ٹھوس طریقوں سے ظاہر ہوتا ہے۔ خواتین میں ہارٹ اٹیک اکثر تھکاوٹ، جبڑے میں درد، متلی، چکر آنا، یا کمر میں درد کے طور پر پیش آتے ہیں بجائے اس کے کہ سینے میں کلاسیکی درد ہو، اور اب بھی مردوں کے مقابلے میں اکثر اس کی غلط تشخیص کی جاتی ہے۔ خواتین میں ADHD اکثر چھوٹ جاتا ہے کیونکہ یہ نصابی کتاب ہائپر ایکٹیو بوائے پیٹرن سے مختلف ہوتا ہے۔ خود کار قوت مدافعت کے حالات غیر متناسب طور پر خواتین پر اثر انداز ہوتے ہیں لیکن اکثر انہیں پریشانی کے طور پر مسترد کر دیا جاتا ہے۔","2":"اوسطاً خواتین میں درد کو کم سنجیدگی سے لیا جاتا ہے۔ مطالعات سے پتہ چلتا ہے کہ خواتین ہنگامی کمروں میں درد کی دوا کے لیے زیادہ انتظار کرتی ہیں اور جسمانی شکایات کے لیے ذہنی صحت کی خدمات کے حوالے کیے جانے کا زیادہ امکان ہوتا ہے۔ یہ جاننا الزام کے بارے میں نہیں ہے، یہ تیاری کے بارے میں ہے، لہذا آپ واضح طور پر وکالت کر سکتے ہیں جب یہ اہم ہو۔","3":"پوچھنا 'یہ اور کیا ہو سکتا ہے؟' طب میں سب سے مفید سوالات میں سے ایک ہے۔ تو یہ ہے 'اگر میں تمہاری بہن ہوتی تو تم کیا کرتی؟' یہ سوالات ماضی کے پیٹرن سے مماثلت کو آگے بڑھاتے ہیں اور ایک نئی شکل دینے پر مجبور کرتے ہیں۔","4":"کسی دوست یا پارٹنر کو اپوائنٹمنٹ پر لے آئیں جب کچھ سنجیدہ محسوس ہو، جذباتی مدد اور کانوں کے اضافی سیٹ دونوں کے لیے۔ پہلے سے سوالات لکھ لیں۔ تحریری طور پر نتائج طلب کریں۔ پوچھیں 'اگر یہ بہتر نہیں ہوتا ہے تو تشخیصی منصوبہ کیا ہے؟' آپ کے جانے سے پہلے.","5":"ہارمونل سیاق و سباق ہر عمر میں اہمیت رکھتا ہے۔ اسی علامت کا مطلب آپ کے بیس، تیس، چالیس اور پچاس کی دہائی میں بہت مختلف چیزیں ہو سکتی ہیں، اور ایک معالج جو آپ کے سائیکل، مانع حمل، حمل، یا پیری مینوپاز کی حیثیت کے بارے میں نہیں پوچھتا ہے، سیاق و سباق غائب ہے۔","6":"نسل اور طبقہ خواتین کی صحت کے نتائج کو بھی شکل دیتا ہے۔ خاص طور پر سیاہ فام خواتین کو زچگی کی صحت کے خراب نتائج اور انہی علامات کی وجہ سے تشخیص میں طویل تاخیر کا سامنا کرنا پڑتا ہے۔ یہ جاننا کہ یہ مایوسی نہیں ہے، یہ ایک وجہ ہے کہ آپ سخت وکالت کریں، مدد فراہم کریں، اور ایسے معالجین کی تلاش کریں جو آپ کو سنجیدگی سے لیں۔","7":"خواتین کی صحت اچھی صحت نہیں ہے۔ یہ نصف آبادی ہے، پوری عمر میں، ایسے حالات کے ساتھ جو جسم کے ہر نظام کو متاثر کرتے ہیں۔ اسے مرکزی خیال کرنا، اختیاری نہیں، دیکھ بھال کی طرح نظر آنا چاہیے۔"},"label":"خواتین کی صحت کو سمجھنا"},"2":{"body":{"0":"عام پریشانیوں میں دردناک ادوار، بہت زیادہ خون بہنا، بے قاعدہ سائیکل، فائبرائڈز، اینڈومیٹرائیوسس، ایڈینومائوسس، ڈمبگرنتی سسٹس، PCOS، بار بار آنے والے UTIs، خمیری انفیکشن، بیکٹیریل وگینوسس، شرونیی فرش کی خرابی، تکلیف دہ جنسی تعلقات، کم لبیڈو، اور غیر مہلکیت میں شامل ہیں۔ زیادہ تر عام ہیں؛ بہت کم نایاب ہیں.","1":"شدید دورانیے کا درد، درد جو آپ کو کام کرنے، سونے، یا حرکت کرنے سے روکتا ہے، اینڈومیٹرائیوسس یا ایڈینومیوسس کی سب سے عام علامات میں سے ایک ہے۔ 'خراب درد عام ہیں' خواتین کی صحت کے لیے سب سے زیادہ نقصان دہ افسانوں میں سے ایک ہے۔ حقیقی درد ایک حقیقی ورزش کا مستحق ہے۔","2":"بھاری ادوار (گھنٹہ کے حساب سے پیڈ یا ٹیمپون کے ذریعے بھگونا، بڑے جمنے، 7 دن سے زیادہ دیر تک) لوہے کی کمی خون کی کمی اور تھکن کا باعث بن سکتے ہیں۔ Fibroids، adenomyosis، polyps، اور تھائیرائیڈ کے مسائل عام وجوہات ہیں، تمام قابل علاج ہیں۔","3":"ماہواری کے درمیان، جنسی تعلقات کے بعد، یا رجونورتی کے بعد خون بہنا ہمیشہ چیک کرنے کے قابل ہوتا ہے۔ زیادہ تر وجوہات بے نظیر ہیں (گریوا کی جلن، پولپس، ہارمونل شفٹ)، لیکن زیادہ سنگین وجوہات کو مسترد کرنا اس سوال کا حصہ ہے کہ کیوں اہمیت ہے۔","4":"سیکس کے ساتھ درد (ڈیسپریونیا) لوگوں کے احساس سے زیادہ عام ہے اور تقریبا ہمیشہ ہی قابل علاج ہے۔ وجوہات اندام نہانی کی خشکی، انفیکشنز، اور شرونیی فرش کے تناؤ سے لے کر اینڈومیٹرائیوسس، داغ کے ٹشو، یا ولووڈینیا تک ہیں۔ ان میں سے کوئی بھی آپ سے 'صرف آگے بڑھنے' کی ضرورت نہیں ہے۔","5":"بار بار آنے والے UTIs اور خمیر کے انفیکشن اکثر سادہ تبدیلیوں، ہائیڈریشن، جنسی تعلقات کے بعد پیشاب کرنے، سانس لینے کے قابل انڈرویئر، اندام نہانی ایسٹروجن اگر perimenopausal کا جواب دیتے ہیں، لیکن وہ ذیابیطس یا ہارمونل شفٹ جیسے بنیادی مسائل کی طرف بھی اشارہ کر سکتے ہیں جو قریب سے دیکھنے کے مستحق ہیں۔","6":"بچے کی پیدائش کے بعد اور پیری مینوپاز میں شرونیی فرش کی خرابی (چھینک کے ساتھ رسنا، فوری طور پر، طول پکڑنا، دردناک جنسی تعلقات، دائمی شرونیی درد) بہت عام ہے۔ پیلوک فلور فزیکل تھراپی خواتین کی صحت میں سب سے زیادہ موثر اور کم استعمال شدہ مداخلتوں میں سے ایک ہے۔","7":"راحت کے راستے کو مختصر کرنے کے لیے تقرریوں کی تفصیلات لائیں۔ 'بھاری ادوار' مبہم ہے؛ 'ہر دو گھنٹے میں تین دن تک سپر ٹیمپون کے ذریعے بھگونا' قابل عمل ہے۔ نمبرز، تاریخوں اور نمونوں سے احساسات سے زیادہ تیز مدد ملتی ہے۔"},"label":"عام تولیدی صحت کے خدشات"},"3":{"body":{"0":"بنیاد رکھیں: مستقل نیند (7-9 گھنٹے)، ہائیڈریشن (2-3 لیٹر)، پروٹین اور فائبر کے ساتھ باقاعدہ کھانا، اور روزانہ کی نقل و حرکت۔ کوئی بھی ڈرامائی نہیں ہے؛ وہ مل کر زیادہ تر دائمی حالات کو روکتے ہیں یا بہتر کرتے ہیں۔","1":"سالانہ بنیادی لیبز حاصل کریں: تھائرائڈ (TSH، مفت T4، TPO اینٹی باڈیز)، آئرن پینل (فیریٹین، نہ صرف ہیموگلوبن)، وٹامن ڈی، B12، فاسٹنگ گلوکوز اور HbA1c، اور ایک مکمل لپڈ پینل۔ اگر سائیکل بند ہو تو ہارمون ٹیسٹنگ شامل کریں۔","2":"3-6 ماہ کے دوران اپنے سائیکل اور علامات کو ٹریک کریں۔ پیٹرن خود کو آہستہ آہستہ ظاہر کرتے ہیں، ایک چارٹ اکثر ایسے سوالات کا جواب دیتا ہے جو سالوں کی مبہم میموری نہیں کر سکتی تھی۔","3":"ایک چھوٹی نگہداشت ٹیم بنائیں جس پر آپ بھروسہ کریں: ایک پرائمری کیئر ڈاکٹر، ایک گائناکالوجسٹ، اور ایک یا دو ماہرین اگر آپ کو کوئی پرانی حالت ہے۔ پیلوک فلور فزیوتھراپسٹ، دماغی صحت کا پیشہ ور، یا رجسٹرڈ غذائی ماہر گیم چینجر ہو سکتا ہے۔","4":"دیکھ بھال کے معاملات کا تسلسل، ایک ڈاکٹر جو آپ کی تاریخ جانتا ہے وہ آپ کو پہلی بار دیکھ کر ایک سے زیادہ پکڑتا ہے۔ اگر آپ سال بھر ایک معالج رکھ سکتے ہیں، تو کریں۔","5":"ہفتے میں دو بار طاقت کی تربیت ہڈیوں کی کثافت کی حفاظت کرتی ہے، ہارمونز کو سہارا دیتی ہے، انسولین کی حساسیت کو بہتر بناتی ہے، اور چوٹ کے خطرے کو کم کرتی ہے۔ جتنی جلدی آپ شروع کریں گے، اتنا ہی اس کی ادائیگی ہوگی۔ بعد میں آپ شروع کرتے ہیں، یہ اب بھی بہت مدد کرتا ہے.","6":"تناؤ کو طبی مسئلے کے طور پر سنبھالیں، شخصیت کی خاصیت نہیں۔ دائمی تناؤ سوزش کو بڑھاتا ہے، خود کار قوت مدافعت کو خراب کرتا ہے، نیند میں خلل ڈالتا ہے، اور درد کو بڑھاتا ہے۔ روز مرہ کی رسومات اور حقیقی آرام دوا ہیں۔","7":"کنکشن کاشت کریں۔ تنہائی کو اب صحت کے لیے اتنا ہی نقصان دہ سمجھا جاتا ہے جتنا تمباکو نوشی۔ چند قابل اعتماد تعلقات زیادہ تر سپلیمنٹس سے زیادہ جسمانی اور ذہنی صحت کی حفاظت کرتے ہیں۔","8":"معافی مانگے بغیر اپنے وکیل بنیں۔ تحریری طور پر نتائج طلب کریں، اگر آپ کو لگتا ہے کہ اس کی ضرورت ہے تو ٹیسٹ کی درخواست کریں، دوسری رائے حاصل کریں، اور اگر آپ کی بات نہیں سنی جا رہی ہے تو معالجین کو تبدیل کریں۔","9":"اپنے جسم پر بھروسہ کریں۔ آپ کی جبلت کہ کچھ بند ہے ڈیٹا ہے، اکثر کمرے کا سب سے اہم ڈیٹا۔"},"label":"صحت کو بہتر بنانے کے لیے نکات"}}}
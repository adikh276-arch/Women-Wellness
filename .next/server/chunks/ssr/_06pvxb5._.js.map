{"food":{"items":{"0":{"detail":"Đậu lăng, rau bina, hạt bí ngô và thịt nạc giúp phục hồi năng lượng trong suốt chu kỳ kinh nguyệt của bạn.","subtitle":"Giúp giảm mệt mỏi và suy nhược do hội chứng tiền kinh nguyệt (PMS).","title":"Ăn các thực phẩm giàu sắt và kẽm"},"1":{"detail":"Các sản phẩm từ sữa, sữa thực vật bổ sung dưỡng chất và rau lá xanh giúp bảo vệ xương lâu dài.","subtitle":"Hỗ trợ xương khớp và giảm các triệu chứng tiền kinh nguyệt.","title":"Tăng cường lượng canxi nạp vào cơ thể"},"2":{"detail":"Đường tinh chế làm tăng tình trạng viêm nhiễm, một nguyên nhân thầm lặng gây ra chuột rút và tâm trạng chán nản.","subtitle":"Giảm viêm và cải thiện tâm trạng","title":"Tránh đường và đồ chiên rán."},"3":{"detail":"Hàm lượng natri thấp hơn = giảm tích nước, đặc biệt là trong những ngày trước kỳ kinh nguyệt.","subtitle":"Giúp ngăn ngừa đầy hơi","title":"Giảm lượng muối"},"4":{"detail":"Cả hai đều có thể gây rối loạn giấc ngủ và làm trầm trọng thêm hội chứng tiền kinh nguyệt. Hãy thử thay thế một tách cà phê bằng trà thảo dược.","subtitle":"Giúp cân bằng nội tiết tố","title":"Hạn chế caffeine và rượu."},"5":{"detail":"Cá hồi, quả óc chó và hạt lanh giúp làm dịu chứng viêm và ổn định tâm trạng.","subtitle":"Hỗ trợ nội tiết tố và giảm đau bụng kinh.","title":"Bổ sung axit béo Omega-3"},"6":{"detail":"Ăn đều đặn mỗi 3-4 giờ giúp duy trì lượng đường trong máu và năng lượng ổn định.","subtitle":"Giảm buồn nôn và ợ chua","title":"Ăn nhiều bữa nhỏ thường xuyên."},"7":{"detail":"Trứng, cá, đậu và sữa chua Hy Lạp giúp ích cho cơ bắp, hormone và cảm giác no.","subtitle":"Hỗ trợ tăng trưởng và phục hồi","title":"Hãy chọn protein chất lượng cao."},"8":{"detail":"Bơ, dầu ô liu và các loại hạt rất cần thiết, chất béo là nhiên liệu cho hormone của bạn.","subtitle":"Hỗ trợ nội tiết tố và giúp da rạng rỡ","title":"Tăng cường chất béo lành mạnh"}},"subtitle":"Tìm hiểu những lời khuyên dinh dưỡng thông minh để hỗ trợ sức khỏe tổng thể của bạn.","title":"Đồ ăn"},"hair-skin":{"items":{"0":{"detail":"Chọn sữa rửa mặt phù hợp với loại da của bạn: gel dịu nhẹ cho da dầu, công thức dạng kem cho da khô.","subtitle":"Chọn loại sữa rửa mặt phù hợp với làn da của bạn","title":"Hãy lựa chọn sữa rửa mặt một cách thông minh!"},"1":{"detail":"Làm sạch da vào ban đêm giúp loại bỏ các chất ô nhiễm tích tụ trong ngày, cho phép da phục hồi trong khi bạn ngủ.","subtitle":"Tẩy trang và làm sạch bụi bẩn trước khi đi ngủ.","title":"Hãy dùng sữa rửa mặt vào ban đêm."},"2":{"detail":"Sử dụng kem chống nắng SPF 30+ mỗi sáng là thói quen chống lão hóa tốt nhất bạn có thể xây dựng.","subtitle":"Việc chống nắng hàng ngày là vô cùng cần thiết.","title":"Hãy nhớ mang theo kem chống nắng."},"3":{"detail":"Vitamin C vào buổi sáng giúp trung hòa các gốc tự do từ ánh nắng mặt trời và ô nhiễm.","subtitle":"Bảo vệ da khỏi tổn thương","title":"Hãy ưu tiên chất chống oxy hóa"},"4":{"detail":"Kem chứa retinoid hoặc peptide sử dụng vào ban đêm giúp hỗ trợ sản sinh collagen và thúc đẩy quá trình tái tạo tế bào.","subtitle":"Phục hồi làn da trong khi bạn ngủ","title":"Quy trình chăm sóc ban đêm"},"5":{"detail":"Sử dụng sản phẩm tẩy tế bào chết hóa học 1-2 lần mỗi tuần, tránh các loại tẩy tế bào chết mạnh gây ra các vết rách nhỏ trên da.","subtitle":"Tẩy tế bào chết nhẹ nhàng, không chà xát mạnh.","title":"Tẩy tế bào chết rất quan trọng"},"6":{"detail":"Dầu xả giúp đóng kín lớp biểu bì, giữ ẩm và giảm gãy rụng tóc.","subtitle":"Cần thiết sau mỗi lần giặt.","title":"Dưỡng tóc"},"7":{"detail":"Tỉa tóc định kỳ 8-12 tuần một lần giúp giữ cho ngọn tóc khỏe mạnh và tóc mọc trông dày hơn.","subtitle":"Ngăn ngừa chẻ ngọn","title":"Hãy cắt tỉa tóc thường xuyên."},"8":{"detail":"Cortisol gây ra mụn và bong tróc da. Giấc ngủ, hít thở sâu và nghỉ ngơi đều rất quan trọng.","subtitle":"Căng thẳng ảnh hưởng đến da và tóc.","title":"Thư giãn và giảm căng thẳng"}},"subtitle":"Khám phá những mẹo đơn giản để có mái tóc khỏe mạnh và làn da rạng rỡ.","title":"Tóc & Da"},"pms":{"items":{"0":{"detail":"Thực phẩm nguyên chất giàu protein và carbohydrate phức tạp giúp giảm các triệu chứng trong suốt chu kỳ kinh nguyệt.","subtitle":"Hỗ trợ cân bằng hormone và giảm mệt mỏi","title":"Hãy tuân theo chế độ ăn uống cân bằng, giàu chất dinh dưỡng."},"1":{"detail":"Ngay cả một cuộc đi bộ 20 phút cũng giải phóng endorphin, giúp âm thầm chống lại các triệu chứng khó chịu của hội chứng tiền kinh nguyệt.","subtitle":"Cải thiện tâm trạng & giảm đau bụng kinh","title":"Tập thể dục thường xuyên"},"2":{"detail":"Căng thẳng làm trầm trọng thêm mọi triệu chứng tiền kinh nguyệt. Hít thở sâu và nghỉ ngơi là điều không thể thiếu.","subtitle":"Giảm các triệu chứng cảm xúc","title":"Quản lý căng thẳng hiệu quả"},"3":{"detail":"Nghe có vẻ phi lý nhưng đó là sự thật: uống nhiều nước hơn đồng nghĩa với việc cơ thể ít giữ nước hơn.","subtitle":"Giảm đầy hơi và khó chịu","title":"Uống đủ nước"},"4":{"detail":"Hãy cố gắng ngủ từ 7-9 tiếng, đặc biệt là trong giai đoạn hoàng thể khi giấc ngủ thường bị ảnh hưởng.","subtitle":"Cải thiện tâm trạng và năng lượng","title":"Ngủ đủ giấc"},"5":{"detail":"Cả hai đều làm trầm trọng thêm chứng lo âu, đau vú và rối loạn giấc ngủ trước kỳ kinh nguyệt.","subtitle":"Ngăn ngừa các vấn đề về giấc ngủ và tâm trạng.","title":"Hạn chế caffeine và rượu."},"6":{"detail":"Magie, vitamin B6 và vitamin D đã được chứng minh có hiệu quả rõ ràng, hãy tham khảo ý kiến bác sĩ trước khi quyết định.","subtitle":"Giúp giảm chuột rút và mệt mỏi","title":"Bổ sung các chất dinh dưỡng thiết yếu"},"7":{"detail":"Việc sử dụng miếng đệm nhiệt đặt ở vùng bụng dưới có thể mang lại hiệu quả tương đương với thuốc giảm đau không cần kê đơn trong trường hợp chuột rút.","subtitle":"Giúp giảm đau bụng kinh một cách tự nhiên","title":"Sử dụng liệu pháp nhiệt để giảm đau."},"8":{"detail":"Các loại quả mọng, cá béo, nghệ và rau lá xanh giúp làm dịu chứng viêm gây ra chuột rút.","subtitle":"Giúp giảm đau do hội chứng tiền kinh nguyệt.","title":"Bổ sung các thực phẩm chống viêm"}},"subtitle":"Tìm cách hiệu quả để kiểm soát các triệu chứng tiền kinh nguyệt và cảm thấy tốt hơn mỗi tháng.","title":"Hội chứng tiền kinh nguyệt"},"weight-loss":{"items":{"0":{"detail":"Hãy thay thế bánh mì trắng và bánh ngọt bằng ngũ cốc nguyên hạt để giữ lượng đường trong máu ổn định.","subtitle":"Ngăn ngừa tăng đột biến đường huyết và tăng cân","title":"Giảm lượng tinh bột tinh chế"},"1":{"detail":"Mỗi bữa ăn chỉ cần một phần nhỏ bằng lòng bàn tay để giúp giảm cảm giác thèm ăn và bảo vệ cơ bắp.","subtitle":"Giúp bạn no lâu và tăng cường trao đổi chất","title":"Ăn nhiều protein hơn"},"2":{"detail":"Thường thì, cơn khát bị nhầm lẫn với cơn đói, vì vậy hãy bắt đầu mỗi bữa ăn với một ly nước.","subtitle":"Hỗ trợ đốt cháy chất béo và giảm cảm giác thèm ăn","title":"Uống nhiều nước hơn"},"3":{"detail":"Hai buổi tập sức mạnh mỗi tuần có tác động đến thành phần cơ thể hiệu quả hơn nhiều so với tập cardio không ngừng nghỉ.","subtitle":"Giúp xây dựng cơ bắp và đốt cháy nhiều calo hơn","title":"Thêm bài tập kháng lực"},"4":{"detail":"Kết hợp đi bộ đều đặn với những đoạn chạy ngắn cường độ cao để tốt cho sức khỏe tim mạch.","subtitle":"Đốt cháy calo và cải thiện thể chất","title":"Tập cardio nhiều hơn"},"5":{"detail":"Hãy đặt mục tiêu tiêu thụ 25–30g rau, các loại đậu, trái cây và ngũ cốc nguyên hạt mỗi ngày.","subtitle":"Giúp bạn no lâu hơn","title":"Bổ sung chất xơ"},"6":{"detail":"Thực phẩm nguyên chất chứa nhiều chất dinh dưỡng; thực phẩm chế biến sẵn chủ yếu chứa các chất phụ gia không cần thiết.","subtitle":"Giảm lượng calo rỗng","title":"Hạn chế thực phẩm chế biến sẵn và đường."},"7":{"detail":"Hãy thư giãn, tránh xa màn hình, não bộ cần khoảng 20 phút để nhận biết cảm giác no.","subtitle":"Ngăn ngừa ăn quá nhiều","title":"Thực hành ăn uống chánh niệm"},"8":{"detail":"Ngủ ít hơn 7 tiếng làm tăng lượng ghrelin và giảm ý chí. Giấc ngủ là một công cụ giúp kiểm soát cân nặng.","subtitle":"Cân bằng hormone gây đói","title":"Ngủ đủ giấc"}},"subtitle":"Nhận những lời khuyên thiết thực để quản lý cân nặng lành mạnh và bền vững.","title":"Giảm cân"}}
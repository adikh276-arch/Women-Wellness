{"food":{"items":{"0":{"detail":"दालें, पालक, कद्दू के बीज और कम वसा वाला मांस आपके मासिक धर्म चक्र के दौरान ऊर्जा की भरपाई करते हैं।","subtitle":"पीएमएस के दौरान होने वाली थकान और कमजोरी को कम करने में मदद करता है","title":"आयरन और जिंक से भरपूर खाद्य पदार्थ खाएं"},"1":{"detail":"डेयरी उत्पाद, पोषक तत्वों से भरपूर वनस्पति दूध और पत्तेदार सब्जियां आपकी हड्डियों को दीर्घकालिक सुरक्षा प्रदान करते हैं।","subtitle":"हड्डियों को सहारा देता है और पीएमएस के लक्षणों को कम करता है","title":"कैल्शियम का सेवन बढ़ाएँ"},"2":{"detail":"प्रसंस्कृत चीनी सूजन को बढ़ाती है, जो ऐंठन और उदासी का एक अप्रत्यक्ष कारण है।","subtitle":"सूजन और मनोदशा में होने वाले बदलावों को कम करता है","title":"चीनी और तले हुए खाद्य पदार्थों से परहेज करें।"},"3":{"detail":"कम सोडियम = कम जल प्रतिधारण, खासकर मासिक धर्म से पहले के दिनों में।","subtitle":"पेट फूलने से रोकने में मदद करता है","title":"नमक की मात्रा कम करें"},"4":{"detail":"ये दोनों ही नींद में खलल डाल सकते हैं और पीएमएस को और खराब कर सकते हैं। एक कप चाय की जगह हर्बल चाय पीने की कोशिश करें।","subtitle":"हार्मोन को संतुलित रखता है","title":"कैफीन और शराब का सेवन सीमित करें"},"5":{"detail":"सैल्मन मछली, अखरोट और अलसी सूजन को शांत करने और मनोदशा को स्थिर करने में मदद करते हैं।","subtitle":"हार्मोन को सहारा देता है और ऐंठन को कम करता है","title":"ओमेगा-3 फैटी एसिड मिलाएं"},"6":{"detail":"हर 3-4 घंटे में खाने से रक्त शर्करा और ऊर्जा का स्तर स्थिर रहता है।","subtitle":"मतली और एसिडिटी को कम करता है","title":"थोड़ी-थोड़ी मात्रा में बार-बार भोजन करें"},"7":{"detail":"अंडे, मछली, बीन्स और ग्रीक दही मांसपेशियों, हार्मोन और तृप्ति में मदद करते हैं।","subtitle":"विकास और पुनर्प्राप्ति में सहायक","title":"उच्च गुणवत्ता वाले प्रोटीन का चयन करें"},"8":{"detail":"एवोकैडो, जैतून का तेल और मेवे आवश्यक हैं, वसा आपके हार्मोन के लिए ईंधन है।","subtitle":"हार्मोन को सहारा देता है और त्वचा को चमकदार बनाता है","title":"स्वस्थ वसा की मात्रा बढ़ाएँ"}},"subtitle":"अपने संपूर्ण स्वास्थ्य को बेहतर बनाने के लिए स्मार्ट पोषण संबंधी सुझाव सीखें।","title":"खाना"},"hair-skin":{"items":{"0":{"detail":"अपनी त्वचा के प्रकार के अनुसार क्लींजर का चुनाव करें, तैलीय त्वचा के लिए सौम्य जेल और शुष्क त्वचा के लिए क्रीमी फॉर्मूले।","subtitle":"अपनी त्वचा के लिए सही क्लींजर चुनें","title":"अपना फेस वॉश समझदारी से चुनें"},"1":{"detail":"रात में चेहरा साफ करने से दिन भर के प्रदूषक साफ हो जाते हैं, जिससे सोते समय आपकी त्वचा की मरम्मत हो पाती है।","subtitle":"सोने से पहले गंदगी और मेकअप हटा लें।","title":"रात में क्लींजर का इस्तेमाल करें"},"2":{"detail":"हर सुबह एसपीएफ 30+ लगाना, बढ़ती उम्र के असर को कम करने की सबसे अच्छी आदत है जिसे आप अपना सकते हैं।","subtitle":"रोजाना धूप से बचाव आवश्यक है","title":"सनस्क्रीन संभाल कर रखें"},"3":{"detail":"सुबह के समय विटामिन सी लेने से सूर्य की रोशनी और प्रदूषण से उत्पन्न होने वाले फ्री रेडिकल्स को बेअसर करने में मदद मिलती है।","subtitle":"त्वचा को नुकसान से बचाएं","title":"एंटीऑक्सीडेंट्स का सेवन करें"},"4":{"detail":"रात में रेटिनॉइड या पेप्टाइड क्रीम लगाने से कोलेजन और कोशिका नवीनीकरण में सहायता मिलती है।","subtitle":"सोते समय त्वचा की मरम्मत करें","title":"रात्रि देखभाल दिनचर्या"},"5":{"detail":"हफ्ते में 1-2 बार केमिकल एक्सफोलिएंट का इस्तेमाल करें, ऐसे कठोर स्क्रब से बचें जो त्वचा में छोटे-छोटे घाव पैदा करते हैं।","subtitle":"धीरे से एक्सफोलिएट करें, ज़ोर से नहीं।","title":"त्वचा की ऊपरी परत को हटाना महत्वपूर्ण है"},"6":{"detail":"कंडीशनर क्यूटिकल को सील कर देता है, जिससे नमी बनी रहती है और बालों का टूटना कम होता है।","subtitle":"हर धुलाई के बाद आवश्यक","title":"अपने बालों को कंडीशन करें"},"7":{"detail":"हर 8-12 सप्ताह में ट्रिमिंग कराने से बालों के सिरे स्वस्थ रहते हैं और बाल घने दिखाई देते हैं।","subtitle":"बालों के दोमुंहे होने से बचाएं","title":"अपने बालों को नियमित रूप से ट्रिम करें"},"8":{"detail":"कोर्टिसोल के कारण त्वचा पर दाने और झुर्रियां पड़ने लगती हैं। नींद, सांस लेना और आराम करना, ये सभी महत्वपूर्ण हैं।","subtitle":"तनाव का असर त्वचा और बालों पर पड़ता है","title":"आराम करें और तनावमुक्त हों"}},"subtitle":"स्वस्थ बालों और दमकती त्वचा के लिए सरल टिप्स जानें।","title":"बाल और त्वचा"},"pms":{"items":{"0"
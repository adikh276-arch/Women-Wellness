{"food":{"items":{"0":{"detail":"Ang mga lentil, spinach, buto ng kalabasa, at mga karneng walang taba ay nagpapanumbalik ng enerhiya sa pamamagitan ng iyong siklo.","subtitle":"Nakakatulong na mabawasan ang pagkapagod at panghihina ng PMS","title":"Kumain ng mga Pagkaing Mayaman sa Iron at Zinc"},"1":{"detail":"Ang mga produktong gawa sa gatas, mga pinatibay na gatas mula sa halaman, at mga madahong gulay ay nagbibigay sa iyong mga buto ng pangmatagalang proteksyon.","subtitle":"Sinusuportahan ang mga buto at binabawasan ang mga sintomas ng PMS","title":"Palakasin ang Paggamit ng Calcium"},"2":{"detail":"Ang naprosesong asukal ay nagpapalala ng pamamaga, isang tahimik na dahilan ng mga pananakit ng ulo at malungkot na pakiramdam.","subtitle":"Binabawasan ang pamamaga at pagbabago ng mood","title":"Iwasan ang mga pagkaing may asukal at pritong pagkain"},"3":{"detail":"Mas mababang sodium = mas kaunting pagpapanatili ng tubig, lalo na sa mga araw bago ang iyong regla.","subtitle":"Nakakatulong maiwasan ang pamumulaklak","title":"Bawasan ang Asin"},"4":{"detail":"Parehong maaaring makagambala sa pagtulog at magpalala ng PMS. Subukang palitan ang isang tasa ng herbal tea.","subtitle":"Pinapanatiling balanse ang mga hormone","title":"Limitahan ang Caffeine at Alkohol"},"5":{"detail":"Ang salmon, walnuts, at flaxseed ay nakakatulong na mapawi ang pamamaga at maging maayos ang mood.","subtitle":"Sinusuportahan ang mga hormone at binabawasan ang mga pulikat","title":"Magdagdag ng Omega-3 Fatty Acids"},"6":{"detail":"Ang pagkain kada 3-4 na oras ay nagpapanatili ng asukal sa dugo, at enerhiya, na matatag.","subtitle":"Binabawasan ang pagduduwal at kaasiman","title":"Kumain ng Mas Maliliit at Madalas na Pagkain"},"7":{"detail":"Ang mga itlog, isda, beans, at Greek yogurt ay nakakatulong sa mga kalamnan, hormones, at kabusugan.","subtitle":"Sinusuportahan ang paglago at paggaling","title":"Pumili ng Mataas na Kalidad na Protina"},"8":{"detail":"Mahalaga ang abokado, langis ng oliba, at mga mani, ang taba ay panggatong para sa iyong mga hormone.","subtitle":"Sinusuportahan ang mga hormone at kumikinang na balat","title":"Dagdagan ang Healthy Fats"}},"subtitle":"Alamin ang mga matalinong tip sa nutrisyon upang suportahan ang iyong pangkalahatang kalusugan.","title":"Pagkain"},"hair-skin":{"items":{"0":{"detail":"Itugma ang iyong panlinis sa uri ng iyong balat, banayad na gel para sa mamantikang balat, at kremang formula para sa tuyong balat.","subtitle":"Pumili ng tamang panlinis para sa iyong balat","title":"Piliin nang Matalino ang Iyong Panghugas ng Mukha"},"1":{"detail":"Ang paglilinis sa gabi ay nag-aalis ng mga polusyon sa araw upang ang iyong balat ay makapagkumpuni habang natutulog ka.","subtitle":"Alisin ang dumi at makeup bago matulog","title":"Gumamit ng mga panlinis sa gabi"},"2":{"detail":"Ang SPF 30+ tuwing umaga ang pinakamahusay na anti-aging habit na maaari mong mabuo.","subtitle":"Mahalaga ang pang-araw-araw na proteksyon sa araw","title":"Maglagay ng Sunscreens"},"3":{"detail":"Ang bitamina C sa umaga ay nakakatulong na i-neutralize ang mga free radicals mula sa araw at polusyon.","subtitle":"Protektahan ang balat mula sa pinsala","title":"Kumuha ng mga Antioxidant"},"4":{"detail":"Ang retinoid o peptide cream sa gabi ay sumusuporta sa collagen at cell turnover.","subtitle":"Ayusin ang balat habang natutulog","title":"Rutina sa Pangangalaga sa Gabi"},"5":{"detail":"Gumamit ng kemikal na exfoliant 1-2 beses linggu-linggo, iwasan ang mga malupit na scrub na nagdudulot ng maliliit na luha.","subtitle":"Dahan-dahang mag-exfoliate, hindi nang marahan","title":"Mahalaga ang Pag-exfoliate"},"6":{"detail":"Tinatakpan ng conditioner ang cuticle, iniinda ang moisture at binabawasan ang pagkabasag.","subtitle":"Mahalaga pagkatapos ng bawat paghuhugas","title":"Kondisyon ng Iyong Buhok"},"7":{"detail":"Ang paggupit kada 8-12 linggo ay nagpapanatiling malusog ang mga dulo at mas makapal ang hitsura ng pagtubo.","subtitle":"Pigilan ang mga hating dulo","title":"Regular na Gupitin ang Iyong Buhok"},"8":{"detail":"Ang Cortisol ay nagdudulot ng breakouts at paglalagas ng balat. Mahalaga ang tulog, paghinga, at pagrerelaks.","subtitle":"Nakakaapekto ang stress sa balat at buhok","title":"Magrelaks at Magbawas ng Stress"}},"subtitle":"Tuklasin ang mga simpleng tip para sa malusog na buhok at kumikinang na balat.","title":"Buhok at Balat"},"pms":{"items":{"0":{"detail":"Ang mga whole food na may matatag na protina at complex carbs ay nakakapagpagaan ng mga sintomas sa buong cycle.","subtitle":"Sinusuportahan ang mga hormone at binabawasan ang pagkapagod","title":"Sundin ang isang Balanseng, Mayaman sa Nutrisyon na Diyeta"},"1":{"detail":"Kahit ang 20 minutong paglalakad ay naglalabas ng mga endorphin na tahimik na lumalaban sa mga sintomas ng PMS.","subtitle":"Palakasin ang mood at pinapawi ang mga cramp","title":"Mag-ehersisyo nang Regular"},"2":{"detail":"Pinapalala ng stress ang bawat sintomas ng PMS. Hindi maaaring pag-usapan ang paghinga at pahinga.","subtitle":"Binabawasan ang mga sintomas ng emosyon","title":"Pamahalaan ang Stress nang Mabisa"},"3":{"detail":"Taliwas sa intuwisyon ngunit totoo, ang mas maraming tubig ay nangangahulugan ng mas kaunting pagpapanatili ng tubig.","subtitle":"Binabawasan ang pamamaga at discomfort","title":"Manatiling Malusog"},"4":{"detail":"Maghangad ng 7-9 na oras, lalo na sa luteal phase kung kailan madalas na nahihirapan sa pagtulog.","subtitle":"Nagpapabuti ng mood at enerhiya","title":"Kumuha ng Sapat na Tulog"},"5":{"detail":"Parehong nagpapalala ng pagkabalisa, pananakit ng dibdib, at pagkagambala sa pagtulog bago ang iyong regla.","subtitle":"Pinipigilan ang mga problema sa pagtulog at mood","title":"Limitahan ang Caffeine at Alkohol"},"6":{"detail":"May matibay na ebidensya ang magnesium, B6, at bitamina D, kaya kausapin muna ang iyong clinician.","subtitle":"Nakakatulong sa mga pulikat at pagkapagod","title":"Uminom ng mga Mahahalagang Suplemento"},"7":{"detail":"Ang heating pad sa ibabang bahagi ng tiyan ay maaaring tumugma sa mga over-the-counter na pain reliever para sa mga pulikat.","subtitle":"Natural na pinapawi ang mga pulikat","title":"Gumamit ng Heat Therapy para sa Pag-alis ng Sakit"},"8":{"detail":"Ang mga berry, matabang isda, turmeric, at madahong gulay ay nakakapagpakalma sa pamamaga sa likod ng mga pananakit ng ulo.","subtitle":"Nakakatulong na mabawasan ang sakit sa PMS","title":"Isama ang mga Pagkaing Anti-Inflammatory"}},"subtitle":"Maghanap ng mga epektibong paraan upang mapamahalaan ang mga sintomas ng PMS at bumuti ang pakiramdam bawat buwan.","title":"PMS"},"weight-loss":{"items":{"0":{"detail":"Palitan ang puting tinapay at mga pastry ng whole grains upang mapanatiling matatag ang asukal sa dugo.","subtitle":"Pinipigilan ang pagtaas ng asukal at pagdami ng taba","title":"Bawasan ang mga Refined Carbs"},"1":{"detail":"Ang isang porsiyong kasinglaki ng palad sa bawat pagkain ay nakakabawas ng mga pagkaing kinakain at nagpoprotekta sa kalamnan.","subtitle":"Pinapanatili kang busog at pinapalakas ang metabolismo","title":"Kumain ng Mas Maraming Protina"},"2":{"detail":"Kadalasan, ang uhaw ay nagbabalatkayo bilang gutom, kaya simulan ang bawat pagkain sa isang basong tubig.","subtitle":"Sinusuportahan ang pagsunog ng taba at binabawasan ang gutom","title":"Uminom ng Mas Maraming Tubig"},"3":{"detail":"Ang dalawang strength session kada linggo ay mas nakapagpapabago sa komposisyon ng katawan kaysa sa walang katapusang cardio.","subtitle":"Nagpapalaki ng kalamnan at nagsusunog ng mas maraming kaloriya","title":"Magdagdag ng Pagsasanay sa Paglaban"},"4":{"detail":"Pagsamahin ang tuloy-tuloy na paglalakad at maiikling paglalakad na may mas matinding intensidad para sa kalusugan ng puso.","subtitle":"Nasusunog ang mga calorie at nagpapabuti sa fitness","title":"Gumawa ng Mas Maraming Cardio"},"5":{"detail":"Layunin na kumain ng 25–30g araw-araw mula sa mga gulay, legume, prutas, at whole grains.","subtitle":"Pinapanatili kang busog nang mas matagal","title":"Magpakasarap sa Fiber"},"6":{"detail":"Ang mga whole food ay may taglay na sustansya; ang mga processed food naman ay kadalasang may mga extra na hindi mo kailangan.","subtitle":"Binabawasan ang mga walang laman na calorie","title":"Limitahan ang mga Naprosesong Pagkain at Asukal"},"7":{"detail":"Dahan-dahan lang, walang screen, kailangan ng utak mo ng mga 20 minuto para ma-record ang pagkabusog.","subtitle":"Pinipigilan ang labis na pagkain","title":"Magsanay ng Maingat na Pagkain"},"8":{"detail":"Ang wala pang 7 oras ay nagpapataas at nagpapababa ng lakas ng loob. Ang pagtulog ay isang paraan ng pagpapapayat.","subtitle":"Binabalanse ang mga hormone ng gutom","title":"Kumuha ng Sapat na Tulog"}},"subtitle":"Kumuha ng mga praktikal na tip para sa malusog at napapanatiling pamamahala ng timbang.","title":"Pagbaba ng Timbang"}}
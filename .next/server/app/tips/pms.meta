{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/tips/layout,_N_T_/tips/[slug]/layout,_N_T_/tips/[slug]/page,_N_T_/tips/pms"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/tips/$d$slug/__PAGE__",
    "/tips/$d$slug",
    "/tips",
    "/_index",
    "/_head"
  ]
}